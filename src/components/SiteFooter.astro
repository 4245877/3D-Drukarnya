---
// Compact navigation keeps every category reachable without JavaScript.
// Articles are linked from the relevant category and product pages.
import { CATEGORIES } from '../data/categories.mjs';
import { OLX_URL, SITE_NAME, SKUFNYA_URL } from '../data/site.config.mjs';
import { href } from '../utils/urls';
import { SITE_COPY } from '../data/i18n.mjs';

interface Props { lang?: string; }
const lang = Astro.props.lang === 'ru' ? 'ru' : Astro.props.lang === 'en' ? 'en' : 'uk';
const copy = SITE_COPY[lang];
const prefix = lang === 'ru' ? 'ru/' : '';

const currentYear = new Date().getFullYear();

const columns = [
  {
    title: copy.catalog,
    links: [
      { label: copy.allCategories, href: href(`${prefix}catalog/`) },
      ...CATEGORIES.map((category, index) => ({
        label: copy.categoryLabels[index],
        href: href(`${prefix}catalog/${category.slug}/`),
      })),
    ],
  },
  {
    title: copy.information,
    links: [
      { label: copy.sla, href: href('sla/') },
      { label: copy.ordering, href: href(`${prefix}#order-title`) },
      { label: 'English overview', href: href('en/') },
      { label: lang === 'ru' ? 'Український каталог' : 'Каталог на русском', href: href(lang === 'ru' ? 'catalog/' : 'ru/catalog/') },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <nav class="site-footer__nav" aria-label={copy.sitemap}>
      {columns.map((column) => (
        <div class="site-footer__column">
          <h2 class="site-footer__column-title">{column.title}</h2>
          <ul class="site-footer__list" role="list">
            {column.links.map((link) => (
              <li>
                <a class="site-footer__nav-link" href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <div class="site-footer__inner">
      <div>
        <strong>{SITE_NAME}</strong>
        <p class="site-footer__text">
          {copy.footer}
        </p>
      </div>

      <div class="site-footer__meta">
        <a
          class="site-footer__link"
          href={OLX_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.olxProfile}
        </a>
        <a
          class="site-footer__link"
          href={SKUFNYA_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          SKUFNYA
        </a>
        <span>© {currentYear}</span>
      </div>
    </div>
  </div>
</footer>
