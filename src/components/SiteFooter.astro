---
// Compact navigation keeps every category reachable without JavaScript.
// Articles are linked from the relevant category and product pages.
import { CATEGORIES } from '../data/categories.mjs';
import { OLX_URL, SITE_NAME, SKUFNYA_URL, TELEGRAM_URL, VIBER_PHONE_LABEL, VIBER_DOWNLOAD_URL } from '../data/site.config.mjs';
import ContactActions from './ContactActions.astro';
import { href } from '../utils/urls';
import { SITE_COPY } from '../data/i18n.mjs';

const copy = SITE_COPY.uk;

const currentYear = new Date().getFullYear();
const telegramUsername = new URL(TELEGRAM_URL).pathname.slice(1);

const columns = [
  {
    title: copy.catalog,
    links: [
      { label: copy.allCategories, href: href('catalog/') },
      ...CATEGORIES.map((category, index) => ({
        label: copy.categoryLabels[index],
        href: href(`catalog/${category.slug}/`),
      })),
    ],
  },
  {
    title: copy.information,
    links: [
      { label: copy.sla, href: href('sla/') },
      { label: copy.ordering, href: href('#order-title') },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <section id="contacts" class="footer-contacts" aria-labelledby="contacts-title" tabindex="-1">
      <div class="footer-contacts__intro">
        <h2 id="contacts-title">Обговорімо твоє замовлення</h2>
        <p>Напиши в зручний месенджер — уточнимо сумісність, виконання та термін до друку.</p>
      </div>
      <div class="footer-contacts__actions">
        <ContactActions />
        <p class="footer-contacts__web-note">Без застосунку скористайся Telegram у браузері. Потрібен вхід у свій акаунт; мій контакт — @{telegramUsername}.</p>
        <details>
          <summary>Не відкрився Viber?</summary>
          <p>Знайди мене у Viber за номером {VIBER_PHONE_LABEL}. Для чату потрібен застосунок. На комп’ютері спершу активуй Viber на телефоні.</p>
          <a href={VIBER_DOWNLOAD_URL} target="_blank" rel="noopener noreferrer">Встановити Viber ↗</a>
        </details>
      </div>
    </section>
    <nav class="site-footer__nav" aria-label={copy.sitemap}>
      {columns.map((column) => (
        <div class="site-footer__column">
          <h2 class="site-footer__column-title">{column.title}</h2>
          <ul class="site-footer__list" role="list">
            {column.links.map((link) => (
              <li>
                <a class="site-footer__nav-link" href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <div class="site-footer__inner">
      <div>
        <strong>{SITE_NAME}</strong>
        <p class="site-footer__text">
          {copy.footer}
        </p>
      </div>

      <div class="site-footer__meta">
        <a
          class="site-footer__link"
          href={OLX_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.olxProfile}
        </a>
        <a
          class="site-footer__link"
          href={SKUFNYA_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          SKUFNYA
        </a>
        <span>© {currentYear}</span>
      </div>
    </div>
  </div>
</footer>
