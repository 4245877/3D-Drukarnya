---
import ProductPrice from './ProductPrice.astro';
import type { Product } from '../utils/products';
import { withBase } from '../utils/products';
import { RUSSIAN_PRODUCTS } from '../data/products.ru.mjs';
import { RUSSIAN_CATEGORIES } from '../data/categories.ru.mjs';
import { getCategoryByName } from '../data/categories.mjs';

import '../styles/components/product-card.css';

interface Props {
  product: Product;
  lang?: 'uk' | 'ru';
}

const { product, lang = 'uk' } = Astro.props;
const isRu = lang === 'ru';
const translated = isRu ? RUSSIAN_PRODUCTS[product.sku] : undefined;
if (isRu && !translated) throw new Error(`Missing Russian copy for ${product.sku}`);
const title = translated?.title ?? product.title;
const description = translated?.summary ?? product.shortDescription;
const categorySlug = getCategoryByName(product.category)?.slug;
const categoryLabel = isRu && categorySlug ? RUSSIAN_CATEGORIES[categorySlug].label : product.category;
const href = `${import.meta.env.BASE_URL}${isRu ? 'ru/' : ''}products/${product.slug}/`;
const imageSrc = withBase(product.images[0]);
// Same typed field that drives the product page and the JSON-LD offer shape.
const isDraft = product.publicationStatus === 'draft';
const priceLabel = isDraft ? (isRu ? 'Ориентировочная цена' : 'Орієнтовна ціна') : product.priceType === 'from' ? (isRu ? 'Цена от' : 'Ціна від') : (isRu ? 'Цена' : 'Ціна');
---

<article class="product-card">
  <a
    class="product-card__image-link"
    href={href}
    aria-label={`${isRu ? 'Перейти к товару' : 'Перейти до товару'} ${title}`}
  >
    {imageSrc && (
      <Fragment>
        {/* Blurred, over-scaled copy of the very same file. It fills the
            letterbox gaps left by photos whose ratio is not the block's 4:3,
            so the photo itself is never cropped and never leaves a bare
            margin. Identical src to the foreground image, so the browser
            serves it from cache — no second network request. */}
        <img
          class="product-card__image-backdrop"
          src={imageSrc}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />

        <img
          class="product-card__image"
          src={imageSrc}
          alt={title}
          loading="lazy"
          decoding="async"
          width="800"
          height="600"
          data-img-fallback
        />
      </Fragment>
    )}
  </a>

  <div class="product-card__body">
    {isDraft && <p class="tag tag--copper">Чернетка · продаж ще не відкрито</p>}
    <p class="product-card__category tag tag--copper">
      {categoryLabel ?? 'Товар'}
    </p>

    <h3 class="product-card__title">
      <a href={href}>{title}</a>
    </h3>

    <p class="product-card__description">{description}</p>

    {/* Price and CTA share one bottom row — stacking them cost the card
        ~90px of height on columns that are now wide enough to hold both. */}
    <div class="product-card__footer">
      <div class="product-card__price-block">
        <span class="product-card__price-label">{priceLabel}</span>
        <ProductPrice amount={product.price} />
      </div>

      <a
        class="btn btn--sm product-card__button"
        href={href}
        aria-label={`${isRu ? 'Подробнее о' : 'Детальніше про'} ${title}`}
      >
        {isRu ? 'Подробнее' : 'Детальніше'}
      </a>
    </div>
  </div>
</article>
