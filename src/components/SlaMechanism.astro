    <g class="sla-mechanism__resin">
      <!-- Resin raft and slender branching supports under the build plate. -->
      <path d="M234 278 295 307 334 287 273 258Z" fill="#533F58" />
      <path d="M234 278 295 307 295 312 234 283Z" fill="#9A6C87" />
      <path d="M295 307 334 287 334 292 295 312Z" fill="#654563" />
      <g fill="none" stroke="#BD8DA2" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M243 286 250 319 259 331 M256 292 261 321 268 327 M272 300 278 322 M290 308 290 329 M307 305 302 329 M324 297 316 323 311 333" />
        <path d="M250 319 249 332 M261 321 256 342 M278 322 273 337 M302 329 308 345 M316 323 323 337" />
      </g>
      <g fill="#D5AAB9" opacity=".8">
        <ellipse cx="243" cy="286" rx="2.6" ry="1.2" />
        <ellipse cx="256" cy="292" rx="2.6" ry="1.2" />
        <ellipse cx="272" cy="300" rx="2.6" ry="1.2" />
        <ellipse cx="290" cy="308" rx="2.6" ry="1.2" />
        <ellipse cx="307" cy="305" rx="2.6" ry="1.2" />
        <ellipse cx="324" cy="297" rx="2.6" ry="1.2" />
