    <!-- Box-section cantilever extends forward from the carriage. -->
    <g class="sla-mechanism__mount">
      <path d="M381 150 403 161 300 213 278 202Z" fill={paint('aluminium')} />
      <path d="M278 202 300 213 300 235 278 224Z" fill={paint('graphite')} />
      <path d="M300 213 403 161 403 183 300 235Z" fill="#485461" />
      <path d="M281 202 300 211 400 161" stroke="#F2E5D0" stroke-width="1.2" stroke-opacity=".68" fill="none" />
      <path d="M307 214 394 170 394 177 307 221Z" fill="#2B3644" />
      <path d="M310 220 391 179" stroke="#BAC2C6" stroke-width="1" stroke-opacity=".34" fill="none" />
      <path d="M311 214 391 174 391 178 311 218Z" fill="#C88463" opacity=".63" />

      <!-- Central mount: locking wheel, stem and ball-joint plate attachment. -->
      <path d="M282 223 298 231 298 254 282 246Z" fill={paint('steel')} />
      <path d="M298 231 308 226 308 249 298 254Z" fill="#4B5867" />
      <path d="M282 223 298 231 308 226 292 218Z" fill="#BAC0BE" />
      <path d="M277 217 293 225 299 222 283 214Z" fill="#4A3440" />
      <path d="M277 217 293 225 293 233 277 225Z" fill={paint('body')} />
      <ellipse cx="278" cy="219" rx="9.4" ry="11.5" transform="rotate(-24 278 219)" fill="#2C303A" />
      <ellipse cx="275" cy="218" rx="8.4" ry="10.6" transform="rotate(-24 275 218)" fill={paint('copper')} />
      <ellipse cx="275" cy="218" rx="4" ry="5.2" transform="rotate(-24 275 218)" fill="#78443C" />
      <path d="M269 211 271 214 M273 208 274 211 M281 216 278 216 M279 225 277 222 M270 224 273 223" stroke="#F1CFAB" stroke-width="1" stroke-opacity=".65" />
    </g>
  </g>
</svg>

<style>
  .sla-mechanism {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .sla-mechanism__moving {
    animation: sla-platform-lift 8s ease-in-out infinite both;
    animation-play-state: paused;
  }

  .sla-mechanism[data-in-view='true'] .sla-mechanism__moving {
    animation-play-state: running;
  }

  @keyframes sla-platform-lift {
    0%, 100% { transform: translateY(0); }
    45%, 55% { transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sla-mechanism__moving { animation: none; }
  }
</style>

<script>
  const mechanisms = document.querySelectorAll<SVGSVGElement>('[data-sla-mechanism]');

  if ('IntersectionObserver' in window) {
    const mechanismObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.setAttribute('data-in-view', String(entry.isIntersecting));
      });
    }, { threshold: 0.2 });

    mechanisms.forEach((mechanism) => mechanismObserver.observe(mechanism));
  } else {
    mechanisms.forEach((mechanism) => mechanism.setAttribute('data-in-view', 'true'));
  }
</script>
