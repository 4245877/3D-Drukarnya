---
interface Props {
  id?: string;
}

const { id = 'sla-mechanism' } = Astro.props;
const paint = (name: string) => `url(#${id}-${name})`;
const screwThreads = Array.from({ length: 46 }, (_, index) => 83 + index * 6);
const railBolts = [90, 125, 245, 285, 325];
---

<svg
  class="sla-mechanism"
  viewBox="40 -12 570 587"
  role="img"
  aria-labelledby={`${id}-title ${id}-description`}
  focusable="false"
  data-sla-mechanism
>
  <title id={`${id}-title`}>Механізм підйому платформи фотополімерного 3D-принтера</title>
  <desc id={`${id}-description`}>
    Каретка рухається вертикально по сталевій напрямній за допомогою ходового
    гвинта та закріпленої на каретці гайки. Жорстка консоль і верхній затиск
    утримують металеву платформу. Мініатюра висить догори дном на підтримках,
    з'єднаних із рафтом на нижній поверхні платформи. Нерухома ванна має
    прозору плівку на дні; LCD-маска й джерело УФ-світла розташовані під нею
    всередині основи. Показано підняту платформу після друку, без захисного
    кожуха: під час засвічення новий шар формується біля дна ванни.
  </desc>

  <defs>
    <linearGradient id={`${id}-body`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#A64B52" />
      <stop offset=".5" stop-color="#843B43" />
      <stop offset="1" stop-color="#58282F" />
    </linearGradient>
    <linearGradient id={`${id}-copper`} x1="0" y1="0" x2="1" y2=".6">
      <stop offset="0" stop-color="#E0AB84" />
      <stop offset=".5" stop-color="#C88463" />
      <stop offset="1" stop-color="#9C5B47" />
    </linearGradient>
    <linearGradient id={`${id}-graphite`} x1="0" y1="0" x2=".35" y2="1">
      <stop offset="0" stop-color="#59616D" />
      <stop offset=".52" stop-color="#3C434D" />
      <stop offset="1" stop-color="#282D35" />
    </linearGradient>
    <linearGradient id={`${id}-steel`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#66717C" />
      <stop offset=".22" stop-color="#D5D8D7" />
      <stop offset=".38" stop-color="#F3E9D7" />
      <stop offset=".56" stop-color="#A2ACB4" />
      <stop offset="1" stop-color="#515A68" />
    </linearGradient>
    <linearGradient id={`${id}-aluminium`} x1="0" y1="0" x2=".7" y2="1">
      <stop offset="0" stop-color="#E0DFD8" />
      <stop offset=".33" stop-color="#ACB4BB" />
      <stop offset=".61" stop-color="#7A8590" />
      <stop offset="1" stop-color="#596574" />
    </linearGradient>
    <linearGradient id={`${id}-plate-edge`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#AEB6BC" />
      <stop offset=".24" stop-color="#707B86" />
      <stop offset="1" stop-color="#39414C" />
    </linearGradient>
    <linearGradient id={`${id}-resin`} x1="0" y1="0" x2=".7" y2="1">
      <stop offset="0" stop-color="#DBA5AA" />
      <stop offset=".35" stop-color="#B97D94" />
      <stop offset=".7" stop-color="#815A78" />
      <stop offset="1" stop-color="#513A58" />
    </linearGradient>
    <radialGradient id={`${id}-resin-surface`} cx=".52" cy=".48" r=".65">
      <stop offset="0" stop-color="#7E506E" />
      <stop offset=".42" stop-color="#443247" />
      <stop offset="1" stop-color="#1D222D" />
    </radialGradient>
    <radialGradient id={`${id}-halo`} cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#C88463" stop-opacity=".13" />
      <stop offset=".62" stop-color="#A64B52" stop-opacity=".05" />
      <stop offset="1" stop-color="#A64B52" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={`${id}-reflection`} cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#E0A4C5" stop-opacity=".09" />
      <stop offset=".42" stop-color="#BA82AC" stop-opacity=".03" />
      <stop offset="1" stop-color="#AA739E" stop-opacity="0" />
    </radialGradient>
    <filter id={`${id}-shadow`} x="-.3" y="-.8" width="1.6" height="2.6">
      <feGaussianBlur stdDeviation="8" />
    </filter>
    <clipPath id={`${id}-vat-clip`}>
      <path d="M145 354 349 456 457 402 253 300Z" />
    </clipPath>
    <clipPath id={`${id}-plate-clip`}>
      <path d="M166 234 338 320 424 277 252 191Z" />
    </clipPath>
  </defs>

  <!-- All horizontal planes share the Hero's 2:1 isometric projection. -->
  <ellipse cx="294" cy="269" rx="244" ry="237" fill={paint('halo')} />
  <path d="M94 427 345 541 584 413 334 294Z" fill="#25191A" opacity=".19" filter={paint('shadow')} />

  <!-- Closed optical chassis: LCD and UV source are below the vat, never above it. -->
  <g class="sla-mechanism__base">
    <path d="M104 426 130 439 130 455 104 442Z" fill="#2E2830" />
    <path d="M338 552 362 540 362 558 338 570Z" fill="#27252C" />
    <path d="M552 429 574 418 574 436 552 447Z" fill="#27252C" />
    <!-- Rear deck supports the Z column outside the tank footprint. -->
    <path d="M93 383 351 512 593 391 335 262Z" fill={paint('copper')} />
    <path d="M93 383 351 512 351 556 93 427Z" fill={paint('body')} />
    <path d="M351 512 593 391 593 435 351 556Z" fill="#54262F" />
    <path d="M105 385 351 508 581 393 335 270Z" fill={paint('graphite')} />
    <path d="M93 383 351 512 593 391" fill="none" stroke="#F1D5B7" stroke-width="1.5" stroke-opacity=".62" />
    <path d="M101 397 351 522" fill="none" stroke="#C88463" stroke-width="1" stroke-opacity=".35" />
    <path d="M101 419 351 544 585 427" fill="none" stroke="#252830" stroke-width="1" stroke-opacity=".55" />
    <!-- Cooling vents belong to the enclosed optical engine. -->
    <path d="M145 426 196 451 M145 432 196 457 M145 438 196 463" fill="none" stroke="#252830" stroke-width="3" stroke-linecap="round" />
    <path d="M385 519 451 486 M385 525 451 492" fill="none" stroke="#B57962" stroke-width="1" stroke-opacity=".3" />
  </g>

  <!-- Fixed Z column: an extruded beam, with a separate front guide and screw. -->
  <g class="sla-mechanism__z-axis" transform="translate(60 -30)">
    <path d="M334 47 371 65 396 52 359 34Z" fill={paint('copper')} />
    <path d="M334 47 371 65 371 373 334 355Z" fill={paint('body')} />
    <path d="M371 65 396 52 396 360 371 373Z" fill="#4A2830" />
    <path d="M378 70 388 65 388 347 378 352Z" fill="#241F27" />
    <path d="M379 72 379 350" fill="none" stroke="#B37862" stroke-width="1" stroke-opacity=".5" />
    <path d="M337 51 337 353 M371 66 371 371" stroke="#E8D8BE" stroke-width="1.2" stroke-opacity=".3" fill="none" />
    <path d="M334 349 371 367 400 353 400 371 371 386 326 364Z" fill={paint('graphite')} />
    <path d="M326 364 371 386 371 399 326 377Z" fill="#30343E" />
    <path d="M371 386 400 371 400 384 371 399Z" fill="#222731" />
    <path d="M340 356 371 371 389 362" fill="none" stroke="#CCD0CD" stroke-opacity=".4" stroke-width="1" />

    <!-- Linear rail: polished raised edges, fasteners and a dark central channel. -->
    <path d="M346 77 362 85 362 351 346 343Z" fill="#343C48" />
    <path d="M346 77 350 79 350 345 346 343Z" fill="#D0D4D1" />
    <path d="M356 82 362 85 362 351 356 348Z" fill={paint('steel')} />
    <path d="M350 80 356 83 356 348 350 345Z" fill="#7A8792" />
    <path d="M349 78 349 343" stroke="#F2E9D7" stroke-width=".9" fill="none" opacity=".8" />
    {railBolts.map((y) => (
      <g>
        <ellipse cx="353" cy={y} rx="2.4" ry="3" fill="#303844" />
        <path d={`M351.7 ${y - .8} 354.3 ${y + .8}`} stroke="#CAD0CD" stroke-width=".8" />
      </g>
    ))}

    <!-- Exposed lead screw, parallel to the rail, with machined helical threads. -->
    <path d="M316 76 326 81 326 355 316 350Z" fill={paint('steel')} />
    {screwThreads.map((y) => (
      <path d={`M316 ${y} 326 ${y - 3}`} stroke="#485364" stroke-width="1.4" fill="none" />
    ))}
    <path d="M320 78 320 351" fill="none" stroke="#E8E5D9" stroke-width="1" stroke-opacity=".5" />

    <!-- Top bearing ties the shaft back to the same column. -->
    <path d="M304 61 329 73 355 60 330 48Z" fill={paint('aluminium')} />
    <path d="M304 61 329 73 329 87 304 75Z" fill={paint('graphite')} />
    <path d="M329 73 355 60 355 74 329 87Z" fill="#303742" />
    <ellipse cx="320" cy="71" rx="7" ry="3.8" fill="#2D343E" />
    <ellipse cx="320" cy="71" rx="4.5" ry="2.3" fill="#B4BDC1" />
    <path d="M306 61 329 72 351 61" stroke="#F1E7D3" stroke-width="1" stroke-opacity=".6" fill="none" />
    <ellipse cx="340" cy="61" rx="2.1" ry="1.2" fill="#535F6B" />

    <!-- Fixed motor and shaft coupling, visible below the moving carriage. -->
    <path d="M298 355 327 369 350 357 321 343Z" fill="#727C85" />
    <path d="M298 355 327 369 327 399 298 385Z" fill={paint('graphite')} />
    <path d="M327 369 350 357 350 387 327 399Z" fill="#252B35" />
    <path d="M300 358 324 370 M300 382 324 394" fill="none" stroke="#C5C8C4" stroke-opacity=".28" stroke-width="1" />
    <path d="M313 335 327 342 327 360 313 353Z" fill={paint('steel')} />
    <ellipse cx="320" cy="338" rx="7" ry="3.5" fill="#BBC2C4" />
    <path d="M313 344 327 351 M313 348 327 355" fill="none" stroke="#475463" stroke-width="1.2" />
    <ellipse cx="324" cy="349" rx="1.4" ry="2" fill="#303C49" />
    <path d="M343 383C353 391 372 387 385 397" fill="none" stroke="#262530" stroke-width="4" stroke-linecap="round" />
    <path d="M343 382C353 390 372 386 385 396" fill="none" stroke="#C88463" stroke-opacity=".42" stroke-width="1" stroke-linecap="round" />
  </g>

  <!-- Resin tank: broad, low, and visibly separate from the build platform. -->
  <g class="sla-mechanism__vat">
    <!-- Rear hold-down lug is occluded by the tank, rather than drawn over the liquid. -->
    <path d="M169 320 183 327 203 317 189 310Z" fill="#737F89" />
    <path d="M169 320 183 327 183 358 169 351Z" fill={paint('graphite')} />
    <path d="M183 327 203 317 203 348 183 358Z" fill="#30343E" />
    <!-- The clear bottom film rests over the masked LCD aperture in the deck. -->
    <path d="M126 379 351 491 478 428 253 316Z" fill="#111720" />
    <path d="M121 350 351 465 483 399 253 284Z" fill="#929CA4" />
    <path d="M121 350 351 465 351 496 121 381Z" fill={paint('graphite')} />
    <path d="M351 465 483 399 483 430 351 496Z" fill="#30343E" />
    <path d="M133 352 349 460 469 400 253 292Z" fill="#161B25" />
    <!-- Dark inner walls keep the liquid visibly below the tank rim. -->
    <path d="M133 352 253 292 253 300 145 354Z" fill="#323541" />
    <path d="M253 292 469 400 457 402 253 300Z" fill="#45434F" />
    <path d="M145 354 349 456 457 402 253 300Z" fill={paint('resin-surface')} />
    <g clip-path={paint('vat-clip')}>
      <ellipse cx="304" cy="390" rx="115" ry="52" fill={paint('reflection')} />
      <path d="M196 356C260 371 300 417 396 416" fill="none" stroke="#DEADBF" stroke-opacity=".14" stroke-width="1.2" />
      <path d="M225 363C259 372 286 389 315 394" fill="none" stroke="#E6BDD0" stroke-opacity=".25" stroke-width="1.1" stroke-linecap="round" />
      <path d="M253 309 447 406" fill="none" stroke="#A8B1BC" stroke-opacity=".13" stroke-width="1.5" />
    </g>
    <path d="M121 350 351 465 483 399" fill="none" stroke="#DADDD5" stroke-width="1.6" stroke-opacity=".76" />
    <path d="M133 352 349 460 469 400 253 292Z" fill="none" stroke="#5F6B79" stroke-width="2" />
    <path d="M127 359 345 468" fill="none" stroke="#707987" stroke-width="1.4" stroke-opacity=".52" />
    <path d="M124 372 351 485" fill="none" stroke="#232631" stroke-width="2" stroke-opacity=".5" />
    <path d="M357 469 475 410" fill="none" stroke="#9CA5AD" stroke-width="1.5" stroke-opacity=".34" />
    <g fill="#29303B" stroke="#A7AFB4" stroke-width=".8">
      <ellipse cx="137" cy="352" rx="2.6" ry="1.6" />
      <ellipse cx="347" cy="460" rx="2.6" ry="1.6" />
      <ellipse cx="472" cy="399" rx="2.6" ry="1.6" />
      <ellipse cx="255" cy="290" rx="2.6" ry="1.6" />
    </g>
    <!-- Tank handles and securing knobs. -->
    <path d="M183 389 218 405 218 415 183 399Z" fill="#2B313B" />
    <path d="M184 389 219 405 219 409 184 393Z" fill="#A0AAB2" />
    <path d="M414 437 452 418 452 427 414 446Z" fill="#222A35" />
    <path d="M414 437 452 418 452 422 414 441Z" fill="#768290" />
    <!-- Hold-down screws sit on external lugs, outside the resin and plate travel. -->
    <path d="M409 428 423 435 443 425 429 418Z" fill="#737F89" />
    <path d="M409 428 423 435 423 466 409 459Z" fill={paint('graphite')} />
    <path d="M423 435 443 425 443 456 423 466Z" fill="#30343E" />
    <path d="M172 309 182 314 192 309 182 304Z" fill={paint('copper')} />
    <path d="M172 309 182 314 182 322 172 317Z" fill="#68323A" />
    <path d="M182 314 192 309 192 317 182 322Z" fill="#462B33" />
    <path d="M420 420 430 425 440 420 430 415Z" fill={paint('copper')} />
    <path d="M420 420 430 425 430 433 420 428Z" fill="#68323A" />
    <path d="M430 425 440 420 440 428 430 433Z" fill="#462B33" />
    <path d="M179 308 185 311 M427 419 433 422" stroke="#F0D0AF" stroke-width="1.2" />
  </g>

  <!-- One rigid moving assembly: carriage, arm, clamp, platform and print. -->
  <g class="sla-mechanism__moving">
    <!-- Lead-screw nut and linear-bearing carriage both fasten to this block. -->
    <g class="sla-mechanism__carriage" transform="translate(60 -30)">
      <path d="M307 151 352 173 377 160 332 138Z" fill={paint('aluminium')} />
      <path d="M307 151 352 173 352 216 307 194Z" fill={paint('graphite')} />
      <path d="M352 173 377 160 377 203 352 216Z" fill="#303743" />
      <path d="M307 153 352 175" stroke="#E8D8BE" stroke-width="1.2" stroke-opacity=".6" fill="none" />
      <path d="M339 153 358 162 370 156 351 147Z" fill="#D0D3CF" />
      <path d="M339 153 358 162 358 190 339 181Z" fill="#677582" />
      <path d="M358 162 370 156 370 184 358 190Z" fill="#414D5B" />
      <path d="M339 181 358 190 370 184" fill="none" stroke="#C7CECE" stroke-width="1" stroke-opacity=".55" />
      <!-- Flanged nut surrounds the lead screw and bolts to the carriage. -->
      <path d="M310 146 332 146 332 163C329 169 314 169 310 163Z" fill={paint('copper')} />
      <ellipse cx="321" cy="146" rx="11" ry="5.5" fill="#D5A87D" />
      <ellipse cx="321" cy="146" rx="5" ry="2.5" fill="#3B414B" />
      <path d="M316 139 326 139 326 145C324 148 318 148 316 145Z" fill={paint('steel')} />
      <path d="M316 142 326 139 M316 146 326 143" stroke="#485364" stroke-width="1.2" />
      <path d="M310 157C316 161 326 161 332 157" fill="none" stroke="#895748" stroke-width="1" />
      <ellipse cx="312.5" cy="149" rx="1.3" ry=".8" fill="#55433A" />
      <ellipse cx="329.5" cy="146" rx="1.3" ry=".8" fill="#55433A" />
      <!-- Dark end seals make the guide bearing's engagement with the rail visible. -->
      <path d="M339 181 358 190 370 184 370 188 358 194 339 185Z" fill="#26313D" />
      <g fill="#232C38" stroke="#A2ABB2" stroke-width=".9">
        <ellipse cx="330" cy="167" rx="2.3" ry="3" />
        <ellipse cx="330" cy="190" rx="2.3" ry="3" />
        <ellipse cx="364" cy="196" rx="2.2" ry="2.8" />
      </g>
      <path d="M329 166 331 168 M329 189 331 191 M363 195 365 197" stroke="#CBD0CC" stroke-width=".8" />
    </g>

    <g class="sla-mechanism__resin">
      <!-- Resin raft and slender branching supports under the build plate. -->
      <path d="M234 277 295 307.5 334 288 273 257.5Z" fill="#533F58" />
      <path d="M234 277 295 307.5 295 311.5 234 281Z" fill="#9A6C87" />
      <path d="M295 307.5 334 288 334 292 295 311.5Z" fill="#654563" />
      <path d="M235 280 295 310 333 291" fill="none" stroke="#D6A6B8" stroke-width=".8" stroke-opacity=".55" />
      <g fill="none" stroke="#BD8DA2" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M243 285 250 311 258 321 M256 291 261 311 268 321 M272 299 278 315 282 325 M290 308 290 329 M307 305 302 317 300 328 M324 297 314 315 311 335" />
        <path d="M250 311 247 337 M261 311 256 325 M278 315 273 324 M302 317 308 332 M314 315 305 330" />
      </g>
      <g fill="#D5AAB9" opacity=".8">
        <ellipse cx="243" cy="285" rx="2.6" ry="1.2" />
        <ellipse cx="256" cy="291" rx="2.6" ry="1.2" />
        <ellipse cx="272" cy="299" rx="2.6" ry="1.2" />
        <ellipse cx="290" cy="308" rx="2.6" ry="1.2" />
        <ellipse cx="307" cy="305" rx="2.6" ry="1.2" />
        <ellipse cx="324" cy="297" rx="2.6" ry="1.2" />
      </g>

      <!-- Inverted resin miniature. Its upper surface stays joined to the supports. -->
      <g transform="translate(283 320) scale(1.12 1.04) translate(-283 -320)">
        <path d="M253 320C266 314 294 320 310 330L315 338C298 343 272 339 251 329Z" fill={paint('resin')} />
        <path d="M253 320C268 325 291 336 310 330" fill="none" stroke="#E3B3BF" stroke-width="1.2" stroke-opacity=".65" />
        <path d="M257 329C252 335 255 344 266 347L274 361 294 363 305 350C313 346 315 340 311 335 301 340 290 337 282 335Z" fill={paint('resin')} />
        <path d="M262 331C267 340 269 347 278 351M275 336C281 345 282 352 279 359M294 341C289 346 289 353 294 358M307 339C304 345 299 346 298 351" fill="none" stroke="#E3BAC7" stroke-opacity=".43" stroke-width="1.2" stroke-linecap="round" />
        <path d="M263 336C253 329 244 331 245 341 245 350 255 358 266 356 257 352 251 344 256 341L266 345Z" fill="#A27490" />
        <path d="M246 339C247 347 254 352 262 354" fill="none" stroke="#D9AABD" stroke-opacity=".65" stroke-width="1" />
        <path d="M283 350C281 355 281 358 286 362L301 363C310 357 312 351 307 346L299 340 297 349Z" fill="#6F4F73" />
        <path d="M280 354C274 355 271 361 275 367L282 375 288 373C289 378 296 379 301 375L311 365C313 360 309 356 303 356L294 351Z" fill={paint('resin')} />
        <path d="M280 367 274 383 288 374M299 374 308 385 308 365" fill="#AA7C95" />
        <path d="M280 367 278 377 285 372M301 374 307 380 307 370" fill="#DFABB9" opacity=".55" />
        <path d="M279 362 287 366 294 361 301 366 308 362M287 366 289 370 297 372 301 366" fill="none" stroke="#E8BECD" stroke-width="1" stroke-opacity=".6" stroke-linejoin="round" />
        <path d="M289 373 294 375 299 372" fill="none" stroke="#5A405C" stroke-width="1.4" stroke-linecap="round" />
        <path d="M252 328 271 337 304 336" fill="none" stroke="#64435F" stroke-width="1" stroke-opacity=".45" />
      </g>
    </g>

    <!-- Build plate fits inside the vat opening when lowered along Z. -->
    <g class="sla-mechanism__platform">
      <path d="M166 234 338 320 424 277 252 191Z" fill={paint('aluminium')} />
      <g clip-path={paint('plate-clip')}>
        <path d="M142 242 320 325 400 185 222 102Z" fill="#F3E8D2" opacity=".13" />
        <path d="M178 243 354 325 M193 235 369 317 M208 227 384 309 M223 219 399 301 M238 211 414 293 M253 203 429 285" fill="none" stroke="#EEF0E9" stroke-opacity=".065" stroke-width="1" />
        <path d="M174 233 338 314 416 276" fill="none" stroke="#EDF0E7" stroke-opacity=".38" stroke-width="1" />
      </g>
      <path d="M166 234 338 320 338 329 166 243Z" fill={paint('plate-edge')} />
      <path d="M338 320 424 277 424 286 338 329Z" fill="#3D4857" />
      <path d="M166 234 338 320 424 277" fill="none" stroke="#F1E9D5" stroke-width="1.5" stroke-opacity=".78" />
      <path d="M168 241 338 327 422 285" fill="none" stroke="#222F3C" stroke-width="1.2" stroke-opacity=".6" />
      <path d="M168 243 338 329 422 287" fill="none" stroke="#BE8FA3" stroke-width=".8" stroke-opacity=".35" />
      <path d="M248 214 295 236 320 224 273 202Z" fill="#4C5866" opacity=".16" />
      <!-- Raised mounting shoe is in front of the top surface. -->
      <path d="M270 247 296 260 320 248 294 235Z" fill="#CED2CE" />
      <path d="M270 247 296 260 296 266 270 253Z" fill="#6B7783" />
      <path d="M296 260 320 248 320 254 296 266Z" fill="#465362" />
      <path d="M282 239 296 246 306 241 292 234Z" fill="#ACB6BC" />
      <path d="M282 239 296 246 296 256 282 249Z" fill={paint('steel')} />
      <path d="M296 246 306 241 306 251 296 256Z" fill="#576675" />
      <path d="M272 247 296 258 318 248" stroke="#F7ECD5" stroke-width="1" stroke-opacity=".75" fill="none" />
      <ellipse cx="279" cy="250" rx="2" ry="1.2" fill="#364351" />
      <ellipse cx="310" cy="250" rx="2" ry="1.2" fill="#364351" />
    </g>

    <!-- Solid cantilever: no horizontal rail, belt or independent X/Y carriage. -->
    <g class="sla-mechanism__mount">
      <path d="M381 150 403 161 300 213 278 202Z" fill={paint('aluminium')} />
      <path d="M278 202 300 213 300 235 278 224Z" fill={paint('graphite')} />
      <path d="M300 213 403 161 403 183 300 235Z" fill="#485461" />
      <path d="M281 202 300 211 400 161" stroke="#F2E5D0" stroke-width="1.2" stroke-opacity=".68" fill="none" />
      <path d="M302 232 400 183" stroke="#A8B2B8" stroke-width="1" stroke-opacity=".35" fill="none" />
      <path d="M383 183 383 190 403 180 403 171Z" fill="#333F4C" />
      <ellipse cx="393" cy="178" rx="2" ry="2.5" fill="#26323F" stroke="#A0AAB1" stroke-width=".7" />

      <!-- Removable platform stem and broad levelling collar above the build plate. -->
      <path d="M282 223 298 231 298 254 282 246Z" fill={paint('steel')} />
      <path d="M298 231 308 226 308 249 298 254Z" fill="#4B5867" />
      <path d="M282 223 298 231 308 226 292 218Z" fill="#BAC0BE" />
      <path d="M279 221 296 229 311 221 294 213Z" fill="#BBC2C4" />
      <path d="M279 221 296 229 296 238 279 230Z" fill={paint('graphite')} />
