<style>
  .sla-mechanism {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .sla-mechanism__moving {
    animation: sla-platform-lift 8s ease-in-out infinite both;
    animation-play-state: paused;
  }

  .sla-mechanism[data-in-view='true'] .sla-mechanism__moving {
    animation-play-state: running;
  }

  @keyframes sla-platform-lift {
    0%, 100% { transform: translateY(0); }
    45%, 55% { transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sla-mechanism__moving { animation: none; }
  }
</style>

<script>
  const mechanisms = document.querySelectorAll<SVGSVGElement>('[data-sla-mechanism]');

  if ('IntersectionObserver' in window) {
    const mechanismObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.setAttribute('data-in-view', String(entry.isIntersecting));
      });
    }, { threshold: 0.2 });

    mechanisms.forEach((mechanism) => mechanismObserver.observe(mechanism));
  } else {
    mechanisms.forEach((mechanism) => mechanism.setAttribute('data-in-view', 'true'));
  }
</script>
