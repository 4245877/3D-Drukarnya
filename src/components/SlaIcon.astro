  smooth: ['M3 16c3-9 6 9 9 0s6 9 9 0', 'M3 8c3-9 6 9 9 0s6 9 9 0'],
  geometry: ['m12 3 9 5v8l-9 5-9-5V8Z', 'm3 8 9 5 9-5M12 13v8M7.5 5.5l9 5M7.5 18.5v-8l9-5'],
  miniature: ['M8 9 6 3l6 3 6-3-2 6', 'M8 9c-4 5-1 9 4 10 5-1 8-5 4-10Z', 'm8 12 4 3 4-3M12 15v4M5 21h14'],
  parts: ['M9 3h6l1 4 4 1 1 6-4 2-1 4H8l-1-4-4-2 1-6 4-1Z', 'M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0'],
  prototype: ['m12 3 8 4v10l-8 4-8-4V7Z', 'm4 7 8 4 8-4M12 11v10M8 5l8 4'],
  arrow: ['M4 12h16m-6-6 6 6-6 6'],
  check: ['m5 12 4 4L19 6'],
  message: ['M21 11a9 9 0 0 1-9 9H3l2-5a9 9 0 1 1 16-4Z', 'M8 10h8M8 14h5'],
} as const;
interface Props { name: keyof typeof paths; }
const { name } = Astro.props;
---
<svg class="sla-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {paths[name].map((d) => <path d={d} />)}
</svg>

<style>
  .sla-icon { width: 24px; height: 24px; flex-shrink: 0; }
</style>
