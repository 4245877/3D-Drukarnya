---
import SlaMechanism from './SlaMechanism.astro';
import SlaIcon from './SlaIcon.astro';
import { href } from '../utils/urls';
---
<section class="sla-preview" aria-labelledby="sla-preview-title">
  <div class="container">
    <div class="sla-preview__inner">
      <div class="sla-preview__copy">
        <p class="kicker">Окремий напрям · SLA-друк</p>
        <h2 id="sla-preview-title">Для тонких деталей<br /><span>моделі</span></h2>
        <p class="sla-preview__lead">
          Для мініатюр, фігурок і невеликих прототипів є фотополімерний друк.
          Він підходить для моделей із тонким рельєфом,
          плавними контурами й дрібними написами. Перед виготовленням модель перевіряє магазин.
        </p>
        <ul class="sla-preview__benefits" role="list">
          <li><SlaIcon name="detail" /> Тонкий рельєф</li>
          <li><SlaIcon name="smooth" /> Гладка поверхня</li>
        </ul>
        <a class="btn btn--primary" href={href('sla/')}>
          Дізнатися про SLA <SlaIcon name="arrow" />
        </a>
        <p class="sla-preview__note">Смола, обробка, вартість і строк узгоджуються до друку.</p>
      </div>
      <figure class="sla-preview__visual">
        <div class="sla-preview__stage">
          <div class="sla-preview__stage-heading" aria-hidden="true">
            <span class="sla-preview__technology">SLA / MSLA</span>
            <span>Фотополімерний друк</span>
          </div>
          <SlaMechanism id="sla-home-mechanism" />
          <div class="sla-preview__stage-footer" aria-hidden="true">
            <span class="sla-preview__axis">Z ↕</span>
            <span>Платформа піднята після друку</span>
          </div>
        </div>
        <figcaption>
          Відкритий механізм MSLA-принтера
          <span>Модель під платформою · засвічення знизу ванни</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .sla-preview {
    padding-block: 0 var(--section-y);
  }

  .sla-preview__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding: var(--space-4);
    border: var(--border-card);
    border-radius: var(--radius-xl);
    background: linear-gradient(115deg, var(--bg-card) 35%, var(--bg-inset));
    box-shadow: var(--shadow-card);
  }

  .sla-preview__copy {
    min-width: 0;
    padding: clamp(1rem, 3vw, 2.5rem);
    padding-right: 0;
  }

  .sla-preview .kicker {
    margin-bottom: var(--space-5);
    line-height: 1.6;
    letter-spacing: .1em;
  }

  .sla-preview h2 {
    margin-bottom: var(--space-5);
    font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.25rem);
    line-height: 1.08;
  }

  .sla-preview h2 span { color: var(--raphtalia-red); }

  .sla-preview__lead {
    max-width: 43ch;
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--fs-base);
    line-height: 1.75;
  }

  .sla-preview__benefits {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .sla-preview__benefits li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }

  .sla-preview__benefits :global(.sla-icon) {
    width: 20px;
    height: 20px;
    color: var(--burgundy);
  }

  .sla-preview .btn {
    max-width: 100%;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-inline: var(--space-6);
    white-space: normal;
  }

  .sla-preview .btn :global(.sla-icon) {
    width: 20px;
    height: 20px;
    transition: transform var(--dur-normal) var(--ease-out);
  }

  .sla-preview .btn:hover :global(.sla-icon) { transform: translateX(3px); }

  .sla-preview__note {
    max-width: 42ch;
    margin: var(--space-4) 0 0;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    line-height: 1.65;
  }

  .sla-preview__visual {
    width: 100%;
    max-width: 460px;
    min-width: 0;
    margin: 0;
    justify-self: end;
  }

  /* The same sunlit paper as the opening of the page: the printer is the darkest
     thing on it, and stands out without a dark box around it. */
  .sla-preview__stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: var(--border-card);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(ellipse 72% 62% at 58% 42%, rgba(255, 216, 162, .6), rgba(255, 216, 162, 0) 76%),
      linear-gradient(180deg, #FFF9F1, var(--paper));
  }

  .sla-preview__stage-heading,
  .sla-preview__stage-footer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6);
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    line-height: 1.5;
  }

  .sla-preview__stage-heading { padding-bottom: 0; }

  .sla-preview__technology {
    color: var(--text-kicker);
    font-weight: var(--fw-bold);
    letter-spacing: .12em;
    white-space: nowrap;
  }

  .sla-preview__stage :global(.sla-mechanism) {
    display: block;
    width: 100%;
    height: auto;
  }

  .sla-preview__stage-footer {
    justify-content: flex-start;
    padding-top: 0;
  }

  .sla-preview__axis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 28px;
    border: 1px solid rgba(142, 63, 67, .3);
    border-radius: var(--radius-sm);
    color: var(--text-kicker);
    font-weight: var(--fw-bold);
  }

  .sla-preview figcaption {
    padding: var(--space-3) var(--space-2) var(--space-1);
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    line-height: 1.7;
    text-align: center;
  }

  .sla-preview figcaption span {
    display: block;
    color: var(--text-muted);
    font-weight: var(--fw-regular);
  }

  @media (max-width: 1024px) {
    .sla-preview__inner { gap: var(--space-5); }
    .sla-preview__copy { padding: var(--space-4); padding-right: 0; }
  }

  @media (max-width: 768px) {
    .sla-preview__inner { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .sla-preview__copy { padding: var(--space-5) var(--space-4) 0; }
    .sla-preview__lead { max-width: 54ch; }
    .sla-preview__visual { max-width: 400px; justify-self: center; }
    .sla-preview .btn { margin-top: var(--space-6); }
  }

  @media (max-width: 480px) {
    .sla-preview__inner { padding: var(--space-3); border-radius: var(--radius-lg); }
    .sla-preview__copy { padding: var(--space-3) var(--space-2) 0; }
    .sla-preview .kicker { letter-spacing: .06em; margin-bottom: var(--space-4); }
    .sla-preview .btn { width: 100%; padding-inline: var(--space-4); }
    .sla-preview__stage-heading,
    .sla-preview__stage-footer { padding-inline: var(--space-4); }
    .sla-preview__stage-heading { align-items: flex-start; }
    .sla-preview__stage-heading > span:last-child { max-width: 15ch; text-align: right; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sla-preview .btn :global(.sla-icon) { transition: none; }
  }
</style>
