---
import { SITE_NAME } from '../data/site.config.mjs';
import ContactIcon from './ContactIcon.astro';
import { CATEGORIES } from '../data/categories.mjs';
import { href } from '../utils/urls';
import { SITE_COPY } from '../data/i18n.mjs';

const copy = SITE_COPY.uk;

interface Props { contactHref?: string }
const { contactHref = '#contacts' } = Astro.props;

const base = href();
const currentPath = Astro.url.pathname;

// Every entry is a real page, not an on-page anchor: the header is the main
// navigation crawlers follow, so it has to expose the site's actual sections.
const links = [
  { label: copy.catalog, href: href('catalog/') },
  { label: copy.sla, href: href('sla/') },
];

// The menu also lists the catalog's sections: on a phone it is the fastest way
// to a category, and the links work without JavaScript.
const categoryLinks = CATEGORIES.map((category, index) => ({
  label: copy.categoryLabels[index],
  href: href(`catalog/${category.slug}/`),
}));

// A section stays marked on its inner pages; the exact page also says so to
// assistive technology.
const isActive = (link: string) => currentPath === link || currentPath.startsWith(link);
const currentOf = (link: string) => (currentPath === link ? 'page' : isActive(link) ? 'true' : undefined);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href={base} aria-label={copy.homeLabel}>
      <img
        class="site-header__logo-mark"
        src={href('logo.svg')}
        width="40"
        height="46"
        alt=""
        aria-hidden="true"
      />
      <span class="site-header__logo-text">{SITE_NAME}</span>
    </a>

    <nav class="site-header__nav" aria-label={copy.navigation}>
      {links.map((link) => (
        <a class="site-header__link" href={link.href} aria-current={currentOf(link.href)}>{link.label}</a>
      ))}
    </nav>

    <a class="site-header__contact" href={contactHref}>
      <ContactIcon name="message" /><span>Зв'язатися</span>
    </a>

    <button
      class="site-header__burger"
      type="button"
      aria-label={copy.openMenu}
      data-open-label={copy.openMenu}
      data-close-label={copy.closeMenu}
      aria-expanded="false"
      aria-controls="site-header-menu"
      hidden
    >
      <span></span><span></span><span></span>
    </button>

    <noscript>
      <details class="site-header__native-menu">
        <summary aria-label={copy.openMenu}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </summary>
        <nav class="site-header__drawer site-header__drawer--native" aria-label={copy.mobileNavigation}>
          <a class="site-header__drawer-link" href={links[0].href} aria-current={currentOf(links[0].href)}>{links[0].label}</a>
          {categoryLinks.map((link) => (
            <a class="site-header__drawer-link site-header__drawer-link--sub" href={link.href} aria-current={currentOf(link.href)}>{link.label}</a>
          ))}
          {links.slice(1).map((link) => (
            <a class="site-header__drawer-link" href={link.href} aria-current={currentOf(link.href)}>{link.label}</a>
          ))}
        </nav>
      </details>
    </noscript>
  </div>

  <nav
    id="site-header-menu"
    class="site-header__drawer"
    aria-label={copy.mobileNavigation}
  >
    <a class="site-header__drawer-link" href={links[0].href} aria-current={currentOf(links[0].href)}>{links[0].label}</a>
    {categoryLinks.map((link) => (
      <a class="site-header__drawer-link site-header__drawer-link--sub" href={link.href} aria-current={currentOf(link.href)}>{link.label}</a>
    ))}
    {links.slice(1).map((link) => (
      <a class="site-header__drawer-link" href={link.href} aria-current={currentOf(link.href)}>{link.label}</a>
    ))}
  </nav>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.site-header__burger');
  const drawer = document.getElementById('site-header-menu');

  if (burger && drawer) {
    const isOpen = () => burger.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', (open ? burger.dataset.closeLabel : burger.dataset.openLabel) ?? '');
      drawer.classList.toggle('is-open', open);
    };

    burger.addEventListener('click', () => {
      setOpen(!isOpen());
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        burger.focus();
      }
    });

    // A tap anywhere outside the menu dismisses it, as on any phone.
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (isOpen() && !drawer.contains(target) && !burger.contains(target)) setOpen(false);
    });

    // Only expose the enhanced control after its handlers are attached.
    burger.hidden = false;
  }
</script>
