---
import { OLX_URL } from '../data/site.config.mjs';
import { href } from '../utils/urls';
import { SITE_COPY } from '../data/i18n.mjs';

interface Props { lang?: string; }
const copy = SITE_COPY[Astro.props.lang === 'en' ? 'en' : 'uk'];

const base = href();

// Every entry is a real page, not an on-page anchor: the header is the main
// navigation crawlers follow, so it has to expose the site's actual sections.
const links = [
  { label: copy.catalog, href: href('catalog/') },
  { label: copy.sla, href: href('sla/') },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href={base} aria-label={copy.homeLabel}>
      <span class="site-header__logo-mark" aria-hidden="true">3D</span>
      <span class="site-header__logo-text">Друкарня</span>
    </a>

    <nav class="site-header__nav" aria-label={copy.navigation}>
      {links.map((link) => (
        <a class="site-header__link" href={link.href}>{link.label}</a>
      ))}
    </nav>

    <a
      class="btn btn--primary btn--sm site-header__cta"
      href={OLX_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={copy.olxLabel}
    >
      {copy.olx}
    </a>

    <button
      class="site-header__burger"
      type="button"
      aria-label={copy.openMenu}
      data-open-label={copy.openMenu}
      data-close-label={copy.closeMenu}
      aria-expanded="false"
      aria-controls="site-header-menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav
    id="site-header-menu"
    class="site-header__drawer"
    aria-label={copy.mobileNavigation}
  >
    {links.map((link) => (
      <a class="site-header__drawer-link" href={link.href}>{link.label}</a>
    ))}
  </nav>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.site-header__burger');
  const drawer = document.getElementById('site-header-menu');

  if (burger && drawer) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', (open ? burger.dataset.closeLabel : burger.dataset.openLabel) ?? '');
      drawer.classList.toggle('is-open', open);
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
