---
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES } from '../../data/categories.mjs';
import { PRICE_PER_GRAM_UAH } from '../../data/pricing.config.mjs';
import { OLX_URL, SITE_NAME } from '../../data/site.config.mjs';
import { getAllProducts } from '../../utils/products';
import { LANGUAGE_ALTERNATES } from '../../data/i18n.mjs';
import { absoluteUrl, href } from '../../utils/urls';
import {
  breadcrumbNode,
  faqNode,
  graph,
  organizationNode,
  webPageNode,
  websiteNode,
} from '../../utils/schema.mjs';
import { toJsonLd } from '../../utils/text';

import '../../styles/pages/content.css';

// A single English entry point, not a translation of the whole site. The
// HomeLab audience searches in English ("10 inch server rack", "rack mount
// for MikroTik", "NAS case Ukraine") even in Ukraine, but the catalogue and
// the guides are written in Ukrainian — so this page states plainly what the
// shop sells, in English, and hands over to the Ukrainian pages. Machine
// translating 50+ pages would create thin duplicates, not value.
const products = getAllProducts();
const rateLabel = new Intl.NumberFormat('en-US', {
  minimumFractionDigits: 0,
  maximumFractionDigits: 2,
}).format(PRICE_PER_GRAM_UAH);

const canonicalPath = '/en/';
const pageUrl = absoluteUrl(canonicalPath);

const title = '10 inch server racks, NAS cases & HomeLab mounts in Ukraine';
const description =
  '10 inch server racks, NAS and Raspberry Pi cases, network and mini PC mounts, drive modules and workspace accessories. Made to order in Kyiv, with OLX Delivery in Ukraine.';

const faq = [
  {
    question: 'Do you ship across Ukraine?',
    answer:
      'Yes. Orders are shipped through OLX Delivery anywhere in Ukraine, subject to size and shipping conditions. Pickup is also available in Kyiv, in the Akademmistechko area.',
  },
  {
    question: 'How do I place an order?',
    answer:
      'Orders go through the seller profile on OLX. Include the product SKU from the catalogue (it starts with the letter P), the quantity, the colour and the material if it matters for your use case.',
  },
  {
    question: 'What is the price based on?',
    answer:
      `Where the printed weight is known, pricing starts with weight × ${rateLabel} UAH per gram; some profiles add a preparation fee. Other items use a comparable product or a provisional starting price. Check the price note in each card. A “from” price needs confirmation for your chosen version. All prices are in Ukrainian hryvnia (UAH).`,
  },
  {
    question: 'Which materials do you print in?',
    answer:
      'The catalogue includes PETG, PLA, ABS and ASA. Check the material stated for the particular item; it varies with the model and its use. If you need a different material, agree it with the shop before production.',
  },
  {
    question: 'Is the catalogue in English?',
    answer:
      'Product pages and guides are in Ukrainian. Hardware names such as MikroTik hAP ac², TP-Link TL-SG108 and Lenovo ThinkCentre M920q stay in their original form, so you can search by model. Please check the compatibility notes too; a similar name alone is not enough.',
  },
];

const breadcrumbItems = [
  { name: 'Home', url: absoluteUrl('') },
  { name: 'English', url: pageUrl },
];

const structuredData = graph([
  websiteNode(),
  organizationNode(),
  {
    ...webPageNode({
      url: pageUrl,
      name: '10 inch server racks and HomeLab parts, made in Ukraine',
      description,
      breadcrumbId: `${pageUrl}#breadcrumbs`,
    }),
    inLanguage: 'en',
  },
  breadcrumbNode(pageUrl, breadcrumbItems),
  faqNode(pageUrl, faq),
]);
---

<Layout
  title={`${title} | ${SITE_NAME}`}
  description={description}
  canonicalPath={canonicalPath}
  lang="en"
  ogLocale="en_US"
  alternates={LANGUAGE_ALTERNATES}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={toJsonLd(structuredData)}
  ></script>

  <div class="content-page">
    <div class="container">
      <Breadcrumbs
        lang="en"
        items={[{ label: 'Home', href: href() }, { label: 'English' }]}
      />

      <header class="content-head">
        <p class="kicker">English overview</p>
        <h1 class="content-head__title content-head__title--wide">
          10 inch server racks and HomeLab parts, made in Ukraine
        </h1>
        <p class="content-lead">
          I’m Raphtalia. I’m glad you’re here, and I’d like your equipment to have
          a comfortable place in your home. At 3D Друкарня you’ll find 10 inch
          server racks, NAS and Raspberry Pi cases, mounts for network gear and
          mini PCs, drive modules, shelves, Keystone panels and workspace organisers.
          The {' '}{products.length} catalogue items are made to order in Kyiv.
          Take your time with the specifications — the small differences matter.
        </p>
      </header>

      <section class="content-section" aria-labelledby="en-what">
        <h2 id="en-what">What the catalogue covers</h2>

        <div class="content-table-wrap">
          <table class="content-table">
            <caption>
              Catalogue sections. Pages are in Ukrainian; hardware model names are
              unchanged.
            </caption>
            <thead>
              <tr>
                <th scope="col">Section</th>
                <th scope="col">What it holds</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row"><a href={href('catalog/10-inch-server-rack/')}>Racks and frames</a></th>
                <td>Modular 10-inch HomeLab frames, reinforced racks and 19-inch Lab Rax parts</td>
              </tr>
              <tr>
                <th scope="row"><a href={href('catalog/cases-and-storage/')}>Cases and drive modules</a></th>
                <td>NAS, PC and Raspberry Pi cases, an ATX bench power supply enclosure, HDD/SSD holders and adapters</td>
              </tr>
              <tr>
                <th scope="row"><a href={href('catalog/equipment-mounts/')}>Equipment mounts</a></th>
                <td>Rack mounts for network devices, mini PCs, Raspberry Pi and power supplies; SMLIGHT and Home Assistant Voice PE wall mounts, a power strip holder and Starlink Gen 3 mount</td>
              </tr>
              <tr>
                <th scope="row"><a href={href('catalog/rack-accessories/')}>Rack accessories</a></th>
                <td>Shelves, Gridfinity drawers, Keystone panels, cable guides, a Synology DS920+ front panel, Honeycomb Storage Wall kit and desktop organiser</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="content-section" aria-labelledby="en-how">
        <h2 id="en-how">Ordering, pricing and delivery</h2>

        <dl class="content-facts">
          <div>
            <dt>Location</dt>
            <dd>Kyiv, Ukraine</dd>
          </div>
          <div>
            <dt>Delivery</dt>
            <dd>OLX Delivery nationwide</dd>
          </div>
          <div>
            <dt>Pickup</dt>
            <dd>Kyiv, Akademmistechko</dd>
          </div>
          <div>
            <dt>Currency</dt>
            <dd>UAH</dd>
          </div>
        </dl>

        <div class="content-prose">
          <p>
            Items are made to order. Read the lead time and price note on the
            product page; some versions still need a confirmed production estimate.
            Where weight is known, the base calculation is {rateLabel} UAH per gram.
            Other prices use a comparable item or a provisional starting estimate.
            I’d rather make that distinction clear now than leave you with an
            unexpected cost when you order.
          </p>
          <p>
            Orders and questions go through the{' '}
            <a href={OLX_URL} target="_blank" rel="noopener noreferrer">
              seller profile on OLX
            </a>. The link opens the profile. Send the shop the SKU (P1, P2, …),
            quantity, colour and chosen version. Only printed plastic parts are
            included; hardware and electronics are agreed separately.
          </p>
        </div>
      </section>

      <section class="content-section" aria-labelledby="en-faq">
        <h2 id="en-faq">FAQ</h2>
        <div class="content-faq">
          {faq.map((item) => (
            <article class="content-faq__item">
              <h3 data-faq-question>{item.question}</h3>
              <p data-faq-answer>{item.answer}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="content-section" aria-labelledby="en-next">
        <h2 id="en-next">Where to go next</h2>
        <ul class="content-linkrow" role="list">
          <li><a href={href()}>Головна / Home (Ukrainian)</a></li>
          <li><a href={href('catalog/')}>Каталог / Catalogue</a></li>
        </ul>
        <div class="content-prose">
          <p>
            The catalogue lists {CATEGORIES.length} sections. Product pages carry the
            specifications, material, price and available compatibility details in
            Ukrainian. Weight and lead time are shown where confirmed. Hardware
            model names stay in their original form, so you can compare them with yours.
          </p>
        </div>
      </section>
    </div>
  </div>
</Layout>
