---
import '../../styles/pages/product.css';
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductPrice from '../../components/ProductPrice.astro';
import { getAllProducts } from '../../utils/products';
import type { Product } from '../../utils/products';
import { parseDescription } from '../../utils/description.mjs';
import { buildProductTitle } from '../../utils/seo.mjs';
import { truncate, toJsonLd } from '../../utils/text';

export function getStaticPaths() {
  return getAllProducts().map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props as Props;

// Short SEO <title> (shared rules in src/utils/seo.mjs); the visible <h1>
// below keeps the full product title.
const pageTitle = buildProductTitle(product.title);

const META_DESCRIPTION_MAX = 160;
const META_DESCRIPTION_SUFFIX = 'FDM 3D-друк у Києві з PLA/PETG під замовлення.';

// The suffix carries the page's target keywords, so the lead has to be cut to
// fit around it — truncating the joined string instead would drop the suffix.
const pageDescription = product.shortDescription
  ? `${truncate(
      product.shortDescription,
      META_DESCRIPTION_MAX - META_DESCRIPTION_SUFFIX.length - 1,
    )} ${META_DESCRIPTION_SUFFIX}`
  : truncate(product.description, META_DESCRIPTION_MAX);

const site = Astro.site ?? new URL('https://4245877.github.io');
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const absoluteBaseUrl = new URL(basePath, site);

const toImageUrl = (image: string) => {
  if (!image) return '';

  if (/^https?:\/\//i.test(image)) return image;
  if (/^\/\//.test(image)) return `https:${image}`;

  return new URL(image.replace(/^\/+/, ''), absoluteBaseUrl).toString();
};

const imageUrls = product.images.map(toImageUrl).filter(Boolean);
const hasImages = imageUrls.length > 0;
// When the product has no usable image, Layout falls back to the site's
// branded OG image on its own (empty string → default).
const ogImage = imageUrls[0] ?? '';

const productUrl = new URL(`products/${product.slug}/`, absoluteBaseUrl).toString();
const catalogUrl = absoluteBaseUrl.toString();
const sellerId = `${catalogUrl}#local-business`;
const logoUrl = new URL('apple-touch-icon.png', absoluteBaseUrl).toString();
const olxUrl = 'https://www.olx.ua/uk/list/user/15L7LS/';
const skufnyaUrl = 'https://www.skufnya.com/';
// Baked in at build time. Anchoring to the end of the build year would mark
// every Offer expired from 1 January until the next deploy, so roll a year on.
const priceValidUntil = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10);

// ── Price & availability: one typed source for the card, this page and the
// JSON-LD offer (see src/data/product.schema.mjs). ─────────────────────────
const isFromPrice = product.priceType === 'from';
const priceLabel = isFromPrice ? 'Ціна від' : 'Ціна';

const AVAILABILITY_SCHEMA_URL: Partial<Record<Product['availability'], string>> = {
  in_stock: 'https://schema.org/InStock',
  made_to_order: 'https://schema.org/MadeToOrder',
  unavailable: 'https://schema.org/OutOfStock',
};
const AVAILABILITY_VISIBLE_TEXT: Partial<Record<Product['availability'], string>> = {
  in_stock: 'В наявності',
  made_to_order: 'Виготовлення під замовлення',
  unavailable: 'Тимчасово недоступно',
};
// Colour tone of the status pill. The status is always spelled out in words —
// the tone only reinforces it, it never carries the meaning on its own.
const AVAILABILITY_TONE: Partial<Record<Product['availability'], string>> = {
  in_stock: 'ready',
  made_to_order: 'made',
  unavailable: 'off',
};
// `unconfirmed` stays undefined in both maps: no availability is published
// and no status line is rendered until the status is confirmed.
const schemaAvailability = AVAILABILITY_SCHEMA_URL[product.availability];
const availabilityText = AVAILABILITY_VISIBLE_TEXT[product.availability];
const availabilityTone = AVAILABILITY_TONE[product.availability];

// ── Order CTA. A validated per-product orderUrl (https, allow-listed host —
// enforced by the schema) wins; otherwise the shared OLX profile is used and
// the note says so honestly. ───────────────────────────────────────────────
const orderHref = product.orderUrl ?? olxUrl;
const hasDirectOrderUrl = Boolean(product.orderUrl);
const orderCtaText = hasDirectOrderUrl
  ? 'Переглянути оголошення цього товару'
  : 'Перейти до продавця на OLX';
// The sticky mobile bar has room for a few words only; both variants stay
// honest about where the link actually goes.
const orderCtaShortText = hasDirectOrderUrl ? 'Відкрити на OLX' : 'Перейти на OLX';
const orderNote = hasDirectOrderUrl
  ? 'Кнопка відкриває окрему сторінку цього товару на OLX.'
  : 'Окремого оголошення для цього товару поки немає. Кнопка відкриває загальний профіль продавця — вкажіть артикул товару в повідомленні.';

const pageKeywords = [
  product.title,
  product.category,
  product.material,
  'FDM 3D-друк Київ',
  '3D друк на замовлення',
  'друк PLA Київ',
  'друк PETG Київ',
  'корпуси для електроніки',
  'прототипування Київ',
]
  .filter(Boolean)
  .join(', ');

// ── Description: paragraphs + simple "- " bullet lists, parsed by a pure
// utility (tested in tests/description.test.mjs) and rendered with regular
// escaping — no set:html anywhere near the raw text. ───────────────────────
const descriptionBlocks = parseDescription(product.description);
const introBlock =
  descriptionBlocks[0]?.type === 'paragraph' ? descriptionBlocks[0] : undefined;
const bodyBlocks = introBlock ? descriptionBlocks.slice(1) : descriptionBlocks;
const hasDescription = descriptionBlocks.length > 0;

const variants = product.variants ?? [];
const hasVariants = variants.length > 0;

const warnings = product.safetyWarnings ?? [];
const hasWarnings = warnings.length > 0;
const warningDefaultTitle = (level: 'notice' | 'critical') =>
  level === 'critical' ? 'Важливе попередження щодо безпеки' : 'Зверніть увагу';

const productFacts = [
  { label: 'Артикул', value: product.sku },
  product.material ? { label: 'Матеріал', value: product.material } : null,
  product.leadTime ? { label: 'Термін виготовлення', value: product.leadTime } : null,
  product.category ? { label: 'Категорія', value: product.category } : null,
  hasVariants
    ? {
        label: 'Варіанти',
        value: product.variantSummary ?? `${variants.length} конфігурацій`,
      }
    : null,
].filter((item): item is { label: string; value: string } => Boolean(item));

const hasFacts = productFacts.length > 0;

// The first screen answers "what is it made of / when is it ready / which
// item is this" with at most three short facts; the full table lives in the
// #product-details section so the buy panel stays scannable.
const keyFacts = [
  product.material ? { label: 'Матеріал', value: product.material } : null,
  product.leadTime ? { label: 'Термін', value: product.leadTime } : null,
  { label: 'Артикул', value: product.sku },
].filter((item): item is { label: string; value: string } => Boolean(item));

// Short, factual reassurance shown under the CTA. Same claims the FDM
// section below makes in prose — nothing new is promised here.
const orderPoints = [
  'Самовивіз у Києві або OLX Доставка по Україні',
  'Матеріал, колір і заповнення узгоджуються перед друком',
  'Невеликі зміни моделі під вашу задачу — за домовленістю',
];

// Page sections, in the order they appear. Drives both the sticky section
// nav and its scroll-spy, so a link can never point at a missing section.
const pageSections = [
  { id: 'product-description', label: 'Опис' },
  hasFacts ? { id: 'product-details', label: 'Характеристики' } : null,
  hasVariants ? { id: 'product-variants', label: 'Варіанти' } : null,
  { id: 'fdm-print-use-cases', label: 'FDM-друк' },
  hasImages ? { id: 'product-gallery', label: 'Фото' } : null,
].filter((item): item is { id: string; label: string } => Boolean(item));

// Public attribution is intentionally separate from internal rights-review
// statuses. Only factual author/source/license metadata is rendered here;
// commercialRightsStatus and photoRightsStatus never affect this page.
const hasAttribution = Boolean(
  product.author || product.sourceUrl || product.license || product.licenseUrl,
);

const additionalProperties = [
  product.material
    ? {
        '@type': 'PropertyValue',
        name: 'Матеріал',
        value: product.material,
      }
    : null,
  product.leadTime
    ? {
        '@type': 'PropertyValue',
        name: 'Термін виготовлення',
        value: product.leadTime,
      }
    : null,
  hasVariants
    ? {
        '@type': 'PropertyValue',
        name: 'Варіанти',
        value: variants.map((variant) => variant.name).join(', '),
      }
    : null,
].filter(Boolean);

const seller = {
  '@type': 'LocalBusiness',
  '@id': sellerId,
  name: '3D Друкарня',
  url: catalogUrl,
  logo: logoUrl,
  sameAs: [olxUrl, skufnyaUrl],
};

const offerShared = {
  priceCurrency: 'UAH',
  priceValidUntil,
  ...(schemaAvailability ? { availability: schemaAvailability } : {}),
  itemCondition: 'https://schema.org/NewCondition',
  url: productUrl,
  eligibleRegion: {
    '@type': 'Country',
    name: 'UA',
  },
  seller,
};

// "Ціна від" publishes an AggregateOffer with only the confirmed minimum
// (lowPrice) — no invented highPrice and no exact Offer.price. All current
// "from" products genuinely aggregate several configurations (variants).
// publishOffer: false keeps the offer out of JSON-LD entirely.
const offers = !product.publishOffer
  ? undefined
  : isFromPrice
    ? { '@type': 'AggregateOffer', lowPrice: product.price, ...offerShared }
    : { '@type': 'Offer', price: product.price, ...offerShared };

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': `${productUrl}#product`,
      name: product.title,
      description: product.description,
      image: hasImages ? imageUrls : undefined,
      sku: product.sku,
      category: product.category,
      material: product.material,
      brand: {
        '@type': 'Brand',
        name: '3D Друкарня',
      },
      additionalProperty: additionalProperties.length > 0 ? additionalProperties : undefined,
      mainEntityOfPage: productUrl,
      offers,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${productUrl}#breadcrumbs`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Каталог 3D-друку',
          item: catalogUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: product.title,
          item: productUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/products/${product.slug}/`}
  image={ogImage}
  imageAlt={product.title}
  keywords={pageKeywords}
  ogType="product"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={toJsonLd(structuredData)}
  ></script>

  <section class="product-page">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Каталог 3D-друку', href: import.meta.env.BASE_URL },
          { label: product.title },
        ]}
      />

      <div class:list={['product-page__hero', { 'product-page__hero--solo': !hasImages }]}>
        {hasImages && (
          <section
            id="product-gallery"
            class="product-page__gallery"
            aria-label="Фотографії товару"
          >
            <ProductGallery title={product.title} images={imageUrls} />
          </section>
        )}

        <div class="product-page__summary">
          <header class="product-summary__head">
            <p class="product-summary__eyebrow">{product.category ?? 'Товар'}</p>

            <h1 id="product-title" class="product-summary__title">
              {product.title}
            </h1>

            {product.shortDescription && (
              <p class="product-summary__lead">{product.shortDescription}</p>
            )}
          </header>

          <section
            id="product-price"
            class="product-buy"
            aria-labelledby="product-price-title"
          >
            <div class="product-buy__price-row">
              <div class="product-buy__price">
                <p id="product-price-title" class="product-page__price-label">{priceLabel}</p>
                <ProductPrice amount={product.price} large={true} />
              </div>

              {availabilityText && (
                <p class="product-buy__status" data-tone={availabilityTone}>
                  <span class="product-buy__status-dot" aria-hidden="true"></span>
                  {availabilityText}
                </p>
              )}
            </div>

            {product.priceNote && (
              <p class="product-buy__price-note">{product.priceNote}</p>
            )}

            {keyFacts.length > 0 && (
              <dl class="product-buy__facts">
                {keyFacts.map((fact) => (
                  <div class="product-buy__fact">
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
            )}

            {hasWarnings && (
              <div class="product-page__warnings">
                {warnings.map((warning, index) => (
                  <section
                    class:list={[
                      'product-warning',
                      { 'product-warning--critical': warning.level === 'critical' },
                    ]}
                    role="note"
                    aria-labelledby={`product-warning-title-${index}`}
                  >
                    <p
                      id={`product-warning-title-${index}`}
                      class="product-warning__title"
                    >
                      <span class="product-warning__icon" aria-hidden="true">⚠</span>
                      <span class="product-warning__badge">
                        {warning.level === 'critical' ? 'Небезпека' : 'Увага'}
                      </span>
                      {warning.title ?? warningDefaultTitle(warning.level)}
                    </p>
                    <p class="product-warning__text">{warning.text}</p>
                  </section>
                ))}
              </div>
            )}

            <div class="product-buy__cta">
              <a
                class="btn btn--primary btn--lg product-page__cta-button"
                href={orderHref}
                target="_blank"
                rel="noopener noreferrer"
                data-order-cta
              >
                <span>{orderCtaText}</span>
                <svg class="product-buy__cta-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14 4h6v6" />
                  <path d="M20 4 11 13" />
                  <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
                </svg>
              </a>
              <p class="product-buy__cta-note">{orderNote}</p>
            </div>
          </section>

          <ul class="product-summary__points" role="list">
            {orderPoints.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      </div>

      <nav class="product-nav" aria-label="Розділи сторінки товару" data-product-nav>
        <div class="product-nav__track">
          {pageSections.map((section, index) => (
            <a
              class="product-nav__link"
              href={`#${section.id}`}
              aria-current={index === 0 ? 'true' : 'false'}
            >
              {section.label}
            </a>
          ))}
        </div>
      </nav>

      <div class="product-page__body">
        <div class="product-page__main">
          <section
            id="product-description"
            class="product-section"
            aria-labelledby="product-description-title"
          >
            <div class="product-section__head">
              <p class="kicker">Опис товару</p>
              <h2 id="product-description-title" class="product-section__title">Опис</h2>
            </div>

            {hasDescription ? (
              <>
                {introBlock && (
                  <p class="product-section__lead">{introBlock.text}</p>
                )}

                {bodyBlocks.length > 0 && (
                  <div class="product-prose">
                    {bodyBlocks.map((block) =>
                      block.type === 'list' ? (
                        <ul class="product-prose__list" role="list">
                          {block.items.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      ) : (
                        <p>{block.text}</p>
                      ),
                    )}
                  </div>
                )}
              </>
            ) : (
              <p class="product-section__lead">
                Опис товару буде додано найближчим часом.
              </p>
            )}
          </section>

          {hasVariants && (
            <section
              id="product-variants"
              class="product-section"
              aria-labelledby="product-variants-title"
            >
              <div class="product-section__head">
                <p class="kicker">Конфігурації</p>
                <h2 id="product-variants-title" class="product-section__title">Варіанти</h2>
              </div>

              <ul class="product-variants" role="list" aria-label="Варіанти товару">
                {variants.map((variant) => (
                  <li class="product-variants__item">
                    <div class="product-variants__head">
                      <h3>{variant.name}</h3>
                      {variant.badge && (
                        <span class="product-variants__badge">{variant.badge}</span>
                      )}
                    </div>

                    <p>{variant.description}</p>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <section
            id="fdm-print-use-cases"
            class="product-section"
            aria-labelledby="fdm-print-use-cases-title"
          >
            <div class="product-section__head">
              <p class="kicker">FDM-друк під замовлення</p>
              <h2 id="fdm-print-use-cases-title" class="product-section__title">
                Для корпусів, кріплень і прототипів
              </h2>
            </div>

            <p class="product-section__lead">
              Цей виріб друкується під замовлення методом FDM. Перед друком можна узгодити
              матеріал, колір, заповнення, міцність і невеликі зміни моделі під вашу задачу.
            </p>

            <ul class="product-usecases" role="list">
              <li>друк PLA або PETG залежно від температури, навантаження та умов використання;</li>
              <li>адаптація отворів, посадкових місць, товщини стінок або кольору;</li>
              <li>виготовлення корпусів для електроніки, кронштейнів, панелей і прототипів;</li>
              <li>самовивіз у Києві або відправлення OLX Доставкою по Україні.</li>
            </ul>
          </section>
        </div>

        <aside class="product-page__rail">
          {hasFacts && (
            <section
              id="product-details"
              class="product-specs"
              aria-labelledby="product-details-title"
            >
              <div class="product-section__head">
                <p class="kicker">Деталі</p>
                <h2 id="product-details-title" class="product-specs__title">Характеристики</h2>
              </div>

              <dl class="product-specs__list">
                {productFacts.map((fact) => (
                  <div class="product-specs__row">
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}

                {product.author && (
                  <div class="product-specs__row">
                    <dt>Автор моделі</dt>
                    <dd>{product.author}</dd>
                  </div>
                )}

                {product.sourceUrl && (
                  <div class="product-specs__row">
                    <dt>Джерело</dt>
                    <dd>
                      <a href={product.sourceUrl} target="_blank" rel="noopener noreferrer">
                        Оригінальна публікація
                      </a>
                    </dd>
                  </div>
                )}

                {(product.license || product.licenseUrl) && (
                  <div class="product-specs__row">
                    <dt>Ліцензія</dt>
                    <dd>
                      {product.licenseUrl ? (
                        <a href={product.licenseUrl} target="_blank" rel="noopener noreferrer">
                          {product.license ?? 'Переглянути умови ліцензії'}
                        </a>
                      ) : (
                        product.license
                      )}
                    </dd>
                  </div>
                )}
              </dl>

              {hasAttribution && (
                <p class="product-specs__note">
                  Модель створена стороннім автором. Тут наведені лише фактичні дані
                  про авторство, джерело та ліцензію.
                </p>
              )}
            </section>
          )}

          <div class="product-recap">
            <p class="product-recap__label">{priceLabel}</p>
            <ProductPrice amount={product.price} large={true} />
            {product.leadTime && (
              <p class="product-recap__meta">Термін виготовлення: {product.leadTime}</p>
            )}
            <a
              class="btn btn--primary product-page__cta-button product-recap__button"
              href={orderHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              {orderCtaShortText}
            </a>
          </div>
        </aside>
      </div>
    </div>

    <div class="product-buybar" data-buybar hidden>
      <div class="product-buybar__inner">
        <div class="product-buybar__price">
          <p class="product-buybar__label">{priceLabel}</p>
          <ProductPrice amount={product.price} />
        </div>

        <a
          class="btn btn--primary product-page__cta-button product-buybar__button"
          href={orderHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          {orderCtaShortText}
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // ── Sticky section nav: scroll-spy + a mobile buy bar that appears once the
  // main CTA has scrolled away. Both are progressive enhancements — the links
  // and the CTA work without any of this.
  const nav = document.querySelector<HTMLElement>('[data-product-nav]');

  if (nav) {
    const track = nav.querySelector<HTMLElement>('.product-nav__track');

    // Fade the edge the tabs continue past, so a narrow strip does not look
    // like the whole set.
    if (track) {
      const updateEdges = () => {
        const remaining = track.scrollWidth - track.clientWidth - track.scrollLeft;
        nav.classList.toggle('has-start', track.scrollLeft > 4);
        nav.classList.toggle('has-end', remaining > 4);
      };

      track.addEventListener('scroll', updateEdges, { passive: true });
      window.addEventListener('resize', updateEdges, { passive: true });
      updateEdges();
    }

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.product-nav__link'));
    const sections = links
      .map((link) => {
        // The gallery sits above the nav and is a "jump back up" shortcut,
        // not a section you read through — spying on it would light up
        // "Фото" while the page is still at the top.
        if (link.hash === '#product-gallery') return null;

        const section = document.querySelector<HTMLElement>(link.hash);
        return section ? { link, section } : null;
      })
      .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => entry !== null);

    if (sections.length > 0) {
      const setActive = (active: HTMLAnchorElement) => {
        for (const { link } of sections) {
          link.setAttribute('aria-current', String(link === active));
        }

        // Keep the active tab in view on the horizontally scrolling mobile nav.
        if (track && track.scrollWidth > track.clientWidth) {
          const offset =
            active.offsetLeft - track.clientWidth / 2 + active.offsetWidth / 2;
          track.scrollTo({ left: Math.max(0, offset), behavior: 'smooth' });
        }
      };

      // Track which sections are on screen and always highlight the topmost
      // one, so short sections between long ones never get skipped.
      const visible = new Set<HTMLElement>();

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const target = entry.target as HTMLElement;
            if (entry.isIntersecting) visible.add(target);
            else visible.delete(target);
          }

          // Viewport coordinates, not offsetTop: the sticky rail is a
          // positioned ancestor, so the specs card measures its offsetTop
          // as 0 and would always win against the description next to it.
          const topmost = sections
            .filter(({ section }) => visible.has(section))
            .sort(
              (a, b) =>
                a.section.getBoundingClientRect().top -
                b.section.getBoundingClientRect().top,
            )[0];

          if (topmost) setActive(topmost.link);
        },
        {
          // Only count a section as "current" once it reaches the area just
          // under the sticky header + nav.
          rootMargin: '-140px 0px -55% 0px',
          threshold: 0,
        },
      );

      for (const { section } of sections) observer.observe(section);
    }
  }

  const buybar = document.querySelector<HTMLElement>('[data-buybar]');
  const heroCta = document.querySelector<HTMLElement>('[data-order-cta]');

  if (buybar && heroCta) {
    // The bar is fixed to the bottom edge, so it would sit on top of the
    // footer at the end of the page — it steps aside once the footer shows up.
    const footer = document.querySelector('.site-footer');
    let frame = 0;

    // Measured per frame rather than through IntersectionObserver: a deep
    // anchor jump moves the CTA out of view in a single frame, which the
    // observer can coalesce into one stale notification.
    const update = () => {
      frame = 0;

      const ctaPassed = heroCta.getBoundingClientRect().bottom < 0;
      const atFooter = footer
        ? footer.getBoundingClientRect().top < window.innerHeight
        : false;

      // `hidden` is only the no-JS state; from here on the bar slides in and
      // out via a class so the transition has something to animate.
      buybar.hidden = false;
      buybar.classList.toggle('is-visible', ctaPassed && !atFooter);
    };

    const schedule = () => {
      if (frame === 0) frame = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    update();
  }
</script>
