---
import Layout from '../components/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SlaIcon from '../components/SlaIcon.astro';
import SlaShowcase from '../components/SlaShowcase.astro';
import { OLX_URL, SITE_NAME } from '../data/site.config.mjs';
import { absoluteUrl, href } from '../utils/urls';
import { ORGANIZATION_ID, breadcrumbNode, faqNode, graph, organizationNode, webPageNode, websiteNode } from '../utils/schema.mjs';
import { toJsonLd } from '../utils/text';
import '../styles/pages/sla.css';

const canonicalPath = '/sla/';
const pageUrl = absoluteUrl(canonicalPath);
const title = `SLA-друк фотополімерною смолою на замовлення | ${SITE_NAME}`;
const description = 'SLA-друк у Києві для мініатюр, фігурок і невеликих прототипів. Перевірка моделі, погодження смоли, обробки, ціни та строку через OLX до виготовлення.';
const applications = [
  { icon: 'miniature' as const, title: 'Мініатюри й фігурки', text: 'Персонажі для настільних ігор, колекційні моделі та скульптури.' },
  { icon: 'parts' as const, title: 'Невеликі деталі', text: 'Декоративні вставки, елементи макетів і дрібні компоненти.' },
  { icon: 'prototype' as const, title: 'Макети й прототипи', text: 'Зразки для перевірки форми, посадки та зовнішнього вигляду.' },
  { icon: 'geometry' as const, title: 'Складна геометрія', text: 'Ажурні конструкції, орнаменти та вигнуті поверхні.' },
];
const steps = [
  { title: 'Модель', text: 'Передай магазину через OLX файл або посилання, розмір, кількість і призначення виробу.' },
  { title: 'Перевірка', text: 'Магазин перевіряє розміри, геометрію, тонкі стінки, дрібні елементи та місця для підтримок.' },
  { title: 'Погодження', text: 'Погодь смолу, обробку, ціну та строк до початку друку.' },
  { title: 'Друк', text: 'Після погодження магазин готує модель і друкує її зі смоли.' },
  { title: 'Обробка', text: 'Виріб промивається й дозасвічується, підтримки знімаються.' },
  { title: 'Отримання', text: 'Узгодь отримання в Києві або доставку по Україні.' },
];
const faq = [
  { question: 'Скільки коштує друк і коли буде готовий виріб?', answer: 'Ціна та строк визначаються після перевірки моделі. На них впливають розмір, кількість, смола, підтримки й обсяг обробки. Узгодь ці умови з магазином на OLX до друку — хочу, щоб ти знав, на що розраховувати.' },
  { question: 'Яку смолу й колір можна обрати?', answer: 'Доступна смола й колір уточнюються для конкретного замовлення. Вкажи призначення: декор, фарбування чи робота під навантаженням. Спеціальні властивості смоли погоджуються окремо; сама деталізація не гарантує потрібної міцності.' },
  { question: 'Чи залишаться сліди на поверхні?', answer: 'Так, у місцях підтримок можливі невеликі сліди. Їхнє розташування та потрібна фінішна обробка погоджуються перед друком. Якщо для тебе важлива певна видима поверхня, зазнач це в запиті. Додаткове шліфування, фарбування та інший фініш узгоджуються окремо.' },
  { question: 'Що робити, якщо немає 3D-файлу?', answer: 'Напиши магазину на OLX, додай зображення або ескіз, приблизні розміри та призначення деталі. Можливість підготовки моделі й її вартість узгоджуються окремо від друку.' },
];
const breadcrumbItems = [{ name: 'Головна', url: absoluteUrl('') }, { name: 'SLA-друк', url: pageUrl }];
const structuredData = graph([
  websiteNode(), organizationNode(),
  webPageNode({ url: pageUrl, name: 'SLA-друк фотополімерною смолою', description, breadcrumbId: `${pageUrl}#breadcrumbs` }),
  breadcrumbNode(pageUrl, breadcrumbItems),
  {
    '@type': 'Service', '@id': `${pageUrl}#sla-service`, name: 'SLA-друк фотополімерною смолою на замовлення',
    serviceType: 'SLA 3D-друк', url: pageUrl, description,
    provider: { '@id': ORGANIZATION_ID },
    areaServed: [{ '@type': 'City', name: 'Київ' }, { '@type': 'Country', name: 'Україна' }],
  },
  faqNode(pageUrl, faq),
]);
---

<Layout title={title} description={description} canonicalPath={canonicalPath} keywords="SLA-друк, фотополімерний друк, друк смолою, 3D-друк мініатюр, друк фігурок, SLA Київ">
  <script is:inline slot="head" type="application/ld+json" set:html={toJsonLd(structuredData)}></script>

  <div class="sla-page">
    <div class="container sla-breadcrumbs">
      <Breadcrumbs items={[{ label: 'Головна', href: href() }, { label: 'SLA-друк' }]} />
    </div>

    <section class="sla-hero" aria-labelledby="sla-title">
      <div class="container sla-hero__inner">
        <div class="sla-hero__copy">
          <p class="kicker">Фотополімерний 3D-друк</p>
          <h1 id="sla-title">SLA-друк<br /><span>зі смоли</span></h1>
          <p class="sla-hero__lead">Тонкий рельєф, дрібні написи й плавні контури заслуговують на увагу. Хочу, щоб ти міг зберегти ці деталі у своїй мініатюрі, фігурці чи прототипі — і заздалегідь знав обмеження смоли.</p>
          <div class="sla-actions">
            <a class="btn btn--primary" href="#sla-order">Підготувати запит <SlaIcon name="arrow" /></a>
            <a class="sla-text-link" href="#sla-compare">SLA чи FDM?</a>
          </div>
          <p class="sla-hero__note"><SlaIcon name="check" /> Смола, обробка, ціна й строк погоджуються до друку.</p>
        </div>
        <figure class="sla-hero__visual">
          <div class="sla-hero__art"><SlaShowcase /></div>
          <figcaption>Ілюстрація: мініатюра й ажурна деталь</figcaption>
        </figure>
      </div>
    </section>

    <section class="sla-section" aria-labelledby="sla-what">
      <div class="container sla-explainer">
        <div><h2 id="sla-what">Як працює SLA</h2></div>
        <div class="sla-explainer__copy"><p>Рідка фотополімерна смола твердіє під дією світла, шар за шаром. Так утворюється виріб із дрібним рельєфом і гладкою поверхнею. У FDM сопло укладає нитку пластику.</p></div>
      </div>
    </section>

    <section class="sla-section sla-applications" aria-labelledby="sla-use">
      <div class="container">
        <div class="sla-section-head"><div><h2 id="sla-use">Що можна надрукувати</h2></div></div>
        <div class="sla-use-grid">
          {applications.map((item, index) => <article class="sla-use-card"><div class="sla-use-card__top"><SlaIcon name={item.icon} /><span>0{index + 1}</span></div><h3>{item.title}</h3><p>{item.text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="sla-section" id="sla-compare" aria-labelledby="sla-compare-title">
      <div class="container">
        <div class="sla-section-head"><div><h2 id="sla-compare-title">SLA чи FDM?</h2></div></div>
        <div class="sla-comparison">
          <article class="sla-tech-card sla-tech-card--resin">
            <div class="sla-tech-card__heading"><span class="tag tag--copper">Фотополімерна смола</span><strong>SLA</strong></div>
            <div class="sla-surface sla-surface--resin" aria-hidden="true"><div></div></div>
            <h3>Дрібний рельєф і деталізація</h3>
            <dl><div><dt>Поверхня</dt><dd>Гладкіша, шари менш помітні; зручна для фарбування</dd></div><div><dt>Для чого</dt><dd>Мініатюри, макети й дрібні деталі</dd></div><div><dt>Обмеження</dt><dd>Міцність залежить від смоли. З тонкими елементами поводься обережно.</dd></div></dl>
          </article>
          <article class="sla-tech-card">
            <div class="sla-tech-card__heading"><span class="tag tag--copper">Пластикова нитка</span><strong>FDM</strong></div>
            <div class="sla-surface sla-surface--fdm" aria-hidden="true"><div></div></div>
            <h3>Корпуси й великі деталі</h3>
            <dl><div><dt>Поверхня</dt><dd>Шари зазвичай помітніші</dd></div><div><dt>Для чого</dt><dd>Корпуси, стійки та великі деталі; може краще підійти для навантажених кріплень</dd></div><div><dt>Умови</dt><dd>Матеріал і напрямок шарів підбираються під навантаження та умови використання.</dd></div></dl>
            <a class="sla-text-link" href={href('catalog/')}>Переглянути технічні вироби <SlaIcon name="arrow" /></a>
          </article>
        </div>
        <p class="sla-comparison-note">Поверхні показано схематично. Результат залежить від моделі, матеріалу, положення деталі під час друку та обробки.</p>
        <div class="sla-help"><SlaIcon name="message" /><p>Для вибору способу друку важливе призначення деталі. Додай до запиту модель і умови використання — форма нижче допоможе зібрати ці відомості.</p><a class="sla-text-link" href="#sla-order">До форми запиту <SlaIcon name="arrow" /></a></div>
      </div>
    </section>

    <section class="sla-section sla-process" aria-labelledby="sla-process-title">
      <div class="container">
        <div class="sla-section-head"><div><h2 id="sla-process-title">Як проходить замовлення</h2></div></div>
        <ol class="sla-steps" role="list">
          {steps.map((step, index) => <li><span class="sla-steps__number">0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="sla-section" id="sla-order" aria-labelledby="sla-order-title">
      <div class="container">
        <div class="sla-order">
          <div class="sla-order__intro">
            <h2 id="sla-order-title">Замовити<br /><span>SLA-друк</span></h2>
            <p>Для розрахунку потрібні модель, бажаний розмір, кількість і призначення. Я раджу додати й те, які деталі поверхні для тебе особливо важливі.</p>
            <ul class="sla-order__checklist" role="list"><li><SlaIcon name="check" /> Файл STL, 3MF або STEP</li><li><SlaIcon name="check" /> Або посилання на модель</li></ul>
            <p class="sla-order__location">Київ · доставка по Україні</p>
          </div>
          <div class="sla-order__body">
            <h3>Запит через OLX</h3>
            <p class="sla-order__instruction">Форма підготує текст повідомлення. Скопіюй його й надішли магазину через профіль продавця на OLX. Якщо файл не у хмарі, узгодь спосіб передачі там.</p>
            <form class="sla-request-form" data-sla-form hidden>
              <div class="sla-field"><label for="sla-model">Посилання на модель <span>необов’язково</span></label><input id="sla-model" name="model" type="url" placeholder="https://…" autocomplete="url" maxlength="2000" /><small>Перевір, що файл відкривається за посиланням.</small></div>
              <div class="sla-field-row"><div class="sla-field"><label for="sla-size">Бажаний розмір</label><input id="sla-size" name="size" type="text" placeholder="Висота 50 мм" maxlength="120" /></div><div class="sla-field"><label for="sla-quantity">Кількість</label><input id="sla-quantity" name="quantity" type="number" inputmode="numeric" min="1" max="10000" value="1" required /></div></div>
              <div class="sla-field"><label for="sla-purpose">Призначення та побажання</label><textarea id="sla-purpose" name="purpose" rows="2" placeholder="Наприклад: мініатюра під фарбування, важливо зберегти дрібні написи" maxlength="1500"></textarea></div>
              <details class="sla-message-preview"><summary>Текст запиту</summary><label class="sr-only" for="sla-message">Текст повідомлення для OLX</label><textarea id="sla-message" data-sla-message readonly rows="6"></textarea></details>
              <div class="sla-order__actions"><button class="btn btn--secondary" type="submit" data-sla-copy>Скопіювати запит</button><a class="btn btn--primary" href={OLX_URL} target="_blank" rel="noopener noreferrer">Перейти на OLX <SlaIcon name="arrow" /></a></div>
              <p class="sla-form-status" data-sla-status role="status" aria-live="polite">Запит ще не надіслано. Скопіюй текст і встав його в повідомлення магазину на OLX.</p>
            </form>
            <noscript><p class="sla-order__instruction">Відкрий профіль продавця на OLX і напиши магазину: «SLA-друк». Додай модель або посилання, бажаний розмір, кількість і призначення виробу.</p><a class="btn btn--primary" href={OLX_URL} target="_blank" rel="noopener noreferrer">Відкрити профіль на OLX <SlaIcon name="arrow" /></a></noscript>
          </div>
        </div>
      </div>
    </section>

    <section class="sla-section sla-faq" aria-labelledby="sla-faq-title">
      <div class="container sla-faq__inner"><div><h2 id="sla-faq-title">Умови замовлення</h2><p><a class="sla-text-link" href={OLX_URL} target="_blank" rel="noopener noreferrer">Поставити питання на OLX <SlaIcon name="arrow" /></a></p></div><div>{faq.map((item) => <details class="sla-faq__item"><summary data-faq-question>{item.question}</summary><p data-faq-answer>{item.answer}</p></details>)}</div></div>
    </section>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-sla-form]');
  const message = document.querySelector<HTMLTextAreaElement>('[data-sla-message]');
  const status = document.querySelector<HTMLElement>('[data-sla-status]');
  if (form && message && status) {
    const composeMessage = () => {
      const data = new FormData(form);
      const model = String(data.get('model') ?? '').trim();
      const size = String(data.get('size') ?? '').trim();
      const purpose = String(data.get('purpose') ?? '').trim();
      message.value = [
        'Вітаю! Хочу замовити SLA-друк фотополімерною смолою.',
        `Модель: ${model || 'спосіб передачі файлу узгодимо в повідомленнях'}`,
        `Бажаний розмір: ${size || 'потрібно уточнити'}`,
        `Кількість: ${data.get('quantity') || '1'} шт.`,
        ...(purpose ? [`Призначення та побажання: ${purpose}`] : []),
        'Чи підходить модель для SLA? Яка смола доступна, скільки коштує друк і коли буде готовий виріб?',
      ].join('\n');
    };
    form.addEventListener('input', () => {
      composeMessage();
      status.textContent = 'Текст оновлено. Скопіюй його й надішли магазину на OLX.';
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      composeMessage();
      try {
        if (!navigator.clipboard) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(message.value);
        status.textContent = 'Текст скопійовано. Запит ще не надіслано: відкрий OLX і встав текст у повідомлення магазину.';
      } catch {
        const preview = form.querySelector<HTMLDetailsElement>('.sla-message-preview');
        if (preview) preview.open = true;
        message.focus();
        message.select();
        status.textContent = 'Автоматичне копіювання не вдалося. Скопіюй виділений текст вручну й надішли магазину на OLX.';
      }
    });
    composeMessage();
    form.hidden = false;
  }
</script>
