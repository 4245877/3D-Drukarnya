---
import Layout from '../components/Layout.astro';
import rackArt from '../assets/hero/rack-art.svg?url';
import rackLedA from '../assets/hero/rack-led-a.svg?url';
import rackLedB from '../assets/hero/rack-led-b.svg?url';
import rackLedC from '../assets/hero/rack-led-c.svg?url';
import rackSheen from '../assets/hero/rack-sheen.svg?url';
import ProductCard from '../components/ProductCard.astro';
import SlaPreview from '../components/SlaPreview.astro';
import ContactActions from '../components/ContactActions.astro';
import { CATEGORIES } from '../data/categories.mjs';
import { FAQ_ITEMS } from '../data/faq';
import { OLX_URL, SITE_NAME } from '../data/site.config.mjs';
import { getAllProducts } from '../utils/products';
import { absoluteUrl, href } from '../utils/urls';
import {
  ORGANIZATION_ID,
  faqNode,
  graph,
  itemListNode,
  organizationNode,
  webPageNode,
  websiteNode,
} from '../utils/schema.mjs';
import { toJsonLd } from '../utils/text';

import '../styles/pages/catalog.css';

const products = getAllProducts();
const featuredProductCount = products.filter((product) => product.featured).length;

// The catalog is entirely about compact home-server hardware, so the home
// page says exactly that. A generic "3D printing service" framing described
// the technology, not what is actually for sale here.
const title = `10-дюймові серверні стійки, NAS-корпуси та rack mount | ${SITE_NAME}`;

const description =
  '10-дюймові стійки для HomeLab, NAS-корпуси, кріплення MikroTik, TP-Link, Raspberry Pi та mini-PC. Сумісність і комплектація в картках. Київ, доставка по Україні.';

const keywords =
  '10-дюймова серверна стійка, mini rack, стійка для HomeLab, NAS корпус, rack mount, кріплення MikroTik, кріплення TP-Link, Raspberry Pi стійка, Lenovo Tiny rack mount, 3D-друк Київ';

const olxUrl = OLX_URL;
const homepageUrl = absoluteUrl('');

// Filters narrow the product grid. Static category links remain available
// through the catalog hub and footer, including with JavaScript disabled.
const categoryLinks = CATEGORIES.map((category) => ({
  ...category,
  count: products.filter((product) => product.category === category.name).length,
}));

const structuredData = graph([
  websiteNode(),
  organizationNode(),
  webPageNode({
    url: homepageUrl,
    name: '10-дюймові серверні стійки, NAS-корпуси та кріплення для HomeLab',
    description,
    type: 'CollectionPage',
  }),
  // No BreadcrumbList: the home page renders no breadcrumb bar, and a
  // single-item trail that points at the page itself describes no path.
  itemListNode(
    homepageUrl,
    CATEGORIES.map((category) => ({
      name: category.heading,
      url: absoluteUrl(`catalog/${category.slug}/`),
    })),
    'Категорії каталогу',
  ),
  {
    '@type': 'Service',
    '@id': `${homepageUrl}#printing-service`,
    name: 'Друк деталей для серверних стійок і HomeLab на замовлення',
    serviceType: 'FDM 3D-друк на замовлення',
    provider: { '@id': ORGANIZATION_ID },
    areaServed: [
      { '@type': 'City', name: 'Київ' },
      { '@type': 'Country', name: 'Україна' },
    ],
    description:
      'Друк 10-дюймових серверних стійок, NAS-корпусів, кріплень і аксесуарів для HomeLab з PETG та PLA, а також друк за моделлю замовника.',
    // No `offers` node: custom printing has no published price, and an Offer
    // carrying only a currency states nothing. Prices live on the products,
    // where they are real. No availability either — this is made to order,
    // and InStock must not be published without a confirmed status.
  },
  // Generated from the same FAQ_ITEMS array as the visible FAQ section
  // below — same questions, same answers, same order, nothing hidden.
  faqNode(homepageUrl, FAQ_ITEMS),
]);
---

<Layout
  title={title}
  description={description}
  canonicalPath="/"
  keywords={keywords}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={toJsonLd(structuredData)}
  ></script>

  <div class="catalog-page" data-catalog-page>
    <section class="catalog-hero" data-live data-parallax>
      {/* Warm copper contours frame the equipment and stay clear of the copy. */}
      <svg class="catalog-hero__strands" viewBox="0 0 1440 700" preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="hero-strand" x1="1" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#CE8C59" stop-opacity="0" />
            <stop offset="0.45" stop-color="#CE8C59" stop-opacity="0.5" />
            <stop offset="1" stop-color="#A8643A" stop-opacity="0.6" />
          </linearGradient>
        </defs>
        <g stroke="url(#hero-strand)">
          <path d="M1470 54C1404 96 1400 196 1338 268S1206 388 1146 520" />
          <path d="M1490 196C1436 226 1418 300 1364 366S1262 470 1216 590" />
          <path d="M1496 332C1452 352 1436 408 1398 462S1320 552 1282 650" />
        </g>
      </svg>

      <div class="container catalog-hero__inner">
        <div class="catalog-hero__left">
          <p class="catalog-hero__eyebrow">10" server rack · HomeLab · NAS</p>

          <h1 class="catalog-hero__title">
            <span class="highlight">10-дюймові</span> серверні стійки та кріплення для HomeLab
          </h1>

          <p class="catalog-hero__subtitle">
            Компактний HomeLab зручніше будувати, коли кожен пристрій має своє місце.
            Тут є стійки, NAS-корпуси, кріплення для mini-PC, Raspberry Pi й мережевого
            обладнання та аксесуари для робочого місця. Виготовлення на замовлення
            в Києві, доставка по Україні.
          </p>

          <div class="catalog-hero__actions">
            <a class="btn btn--primary btn--lg" href="#catalog-title">Переглянути каталог</a>
            <a class="btn btn--secondary btn--lg" href="#order-title">Як замовити</a>
            <a class="catalog-hero__sla-link" href={href('sla/')}>SLA-друк смолою →</a>
          </div>

          <ul class="catalog-hero__facts" role="list">
            <li class="catalog-hero__fact"><strong>{products.length}</strong> виробів у каталозі</li>
            <li class="catalog-hero__fact"><strong>{CATEGORIES.length}</strong> розділи</li>
            <li class="catalog-hero__fact"><strong>Київ</strong> доставка по Україні</li>
          </ul>
        </div>

        <div class="catalog-hero__aside">
          <span class="catalog-hero__sun" aria-hidden="true">
            <svg viewBox="0 0 600 600" focusable="false">
              <circle cx="300" cy="300" r="238" stroke-opacity="0.34" />
            </svg>
            <span class="catalog-hero__sun-spin"><svg viewBox="0 0 600 600" focusable="false">
              <circle cx="300" cy="300" r="282" stroke-opacity="0.45" stroke-dasharray="2 14" stroke-linecap="round" />
            </svg></span>
          </span>

          <span class="leaf catalog-hero__leaf catalog-hero__leaf--a"></span>
          <span class="leaf catalog-hero__leaf catalog-hero__leaf--b"></span>
          <span class="leaf catalog-hero__leaf catalog-hero__leaf--c"></span>

          <!-- Серверна стійка — обов'язковий елемент Hero на всіх екранах, включно з мобільними. Не приховувати й не видаляти під час адаптації. -->
          <div class="catalog-hero__rack" aria-hidden="true" data-parallax-layer data-parallax-x="14" data-parallax-y="8">
              <!--
                Isometric open 10" home-lab rack (5U): patch panel, switch,
                mini-PC on a printed shelf, 4-bay NAS. 2:1 isometric grid:
                front-plane lines slope dy = +dx/2, side-plane dy = -dx/2.
                Printed parts (frame, rail, shelf, feet) = burgundy/copper,
                equipment = graphite/steel, highlights = cream, LEDs = warm.
              -->
              <img class="rack-art" src={rackArt} alt="" width="256" height="312" decoding="async" fetchpriority="high" draggable="false" />
              {/* Small independent viewports retain the original SVG coordinates.
                  Only the cable's short path still needs animated SVG paint;
                  the static artwork is cached independently, with the same silhouette shadow. */}
              <span class="rack-detail rack-led--blink-a"><img src={rackLedA} alt="" width="10" height="10" decoding="async" draggable="false" /></span>
              <span class="rack-detail rack-led--blink-b"><img src={rackLedB} alt="" width="8" height="8" decoding="async" draggable="false" /></span>
              <span class="rack-detail rack-led--blink-c"><img src={rackLedC} alt="" width="9" height="9" decoding="async" draggable="false" /></span>
              <span class="rack-detail rack-cable-window"><svg viewBox="145 82 36 33" focusable="false">
                <path class="rack-cable-pulse" d="M158 84 C149 94 147 105 157 110 C163 113 172 111 179 107" pathLength="100" fill="none" stroke="#F6E7CB" stroke-width="3" stroke-linecap="round" />
              </svg></span>
              <span class="rack-sheen-clip">
                <span class="rack-sheen"><img src={rackSheen} alt="" width="256" height="312" decoding="async" draggable="false" /></span>
              </span>
          </div>
        </div>
      </div>

      <svg class="catalog-hero__wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="hero-wave-line" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#CE8C59" stop-opacity="0" />
            <stop offset="0.3" stop-color="#CE8C59" />
            <stop offset="0.75" stop-color="#AC4151" />
            <stop offset="1" stop-color="#AC4151" stop-opacity="0.2" />
          </linearGradient>
        </defs>
        <path class="catalog-hero__wave-fill" d="M0 58C210 22 410 14 650 40S1050 86 1240 62S1400 26 1440 28V90H0Z" />
        <path class="catalog-hero__wave-line" stroke="url(#hero-wave-line)" d="M0 58C210 22 410 14 650 40S1050 86 1240 62S1400 26 1440 28" />
      </svg>
    </section>

    {/*
      The catalog itself opens the page. On wide screens its navigation is a
      narrow sidebar beside the products; on small screens the same controls
      become an off-canvas drawer. Category descriptions live in the catalog
      hub; the footer keeps ordinary links to every category page.
    */}
    <section
      class="catalog-main"
      id="catalog"
      aria-labelledby="catalog-title"
      data-catalog-main
    >
      <div class="container">
        <h2 id="catalog-title" class="sr-only">Каталог товарів</h2>

        {/* Hidden until filtering is successfully initialised, so the no-JS
            page never exposes a drawer control that cannot open anything.
            The trigger doubles as the state readout: it names the section and
            the category currently in effect, so the answer to "where am I"
            never depends on opening the drawer. */}
        <div class="catalog-mobile-toolbar" hidden data-catalog-mobile-toolbar>
          <button
            class="catalog-mobile-trigger"
            type="button"
            aria-expanded="false"
            aria-controls="catalog-sidebar"
            data-catalog-sidebar-open
          >
            <span class="catalog-mobile-trigger__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18">
                <path d="M4 7h16M7 12h10M10 17h4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
              </svg>
            </span>

            <span class="catalog-mobile-trigger__text">
              <span class="catalog-mobile-trigger__eyebrow">Каталог</span>
              <span class="catalog-mobile-trigger__value" data-catalog-active-label>Усі товари</span>
            </span>

            <svg
              class="catalog-mobile-trigger__chevron"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              aria-hidden="true"
            >
              <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <p class="catalog-mobile-summary">
            <strong data-catalog-visible-count>{products.length}</strong>
            <span>позицій</span>
          </p>
        </div>

        <div class="catalog-layout">
          {/* Head / body / foot, in that order: as a drawer the panel is a
              full-height column whose head and foot are pinned, so the close
              button and the category link never scroll out of reach. */}
          <aside
            id="catalog-sidebar"
            class="catalog-sidebar"
            aria-labelledby="catalog-sidebar-title"
            data-catalog-sidebar
          >
            <div class="catalog-sidebar__head">
              <div class="catalog-sidebar__heading">
                <p class="catalog-sidebar__eyebrow">Навігація</p>
                <p id="catalog-sidebar-title" class="catalog-sidebar__title">Каталог</p>
              </div>

              <button
                class="catalog-sidebar__close"
                type="button"
                aria-label="Закрити фільтри каталогу"
                data-catalog-sidebar-close
              >
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path d="M7 7l10 10M17 7L7 17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </button>
            </div>

            <div class="catalog-sidebar__body" data-catalog-sidebar-body>
              <p class="catalog-sidebar__count">
                Показано <strong data-catalog-visible-count>{products.length}</strong> із{' '}
                <strong>{products.length}</strong> позицій
              </p>

              {/* Progressive enhancement: controls are revealed only after every
                  filter target is found. Without JS all products stay visible and
                  static category links remain in the catalog hub and footer. */}
              <nav
                class="catalog-filters"
                aria-label="Фільтри каталогу"
                hidden
                data-catalog-category-nav
              >
                {/* Two levels, told apart by shape: the scope of the listing is a
                    segmented control, the categories below it are a list. */}
                <div class="catalog-filter-group" role="group" aria-labelledby="catalog-quick-filters">
                  <p id="catalog-quick-filters" class="catalog-filter-group__title">Показувати</p>
                  <div class="catalog-filter-list catalog-filter-list--quick">
                    <button
                      class="catalog-filter"
                      type="button"
                      aria-pressed="true"
                      data-catalog-filter="all"
                    >
                      <span class="catalog-filter__label" data-catalog-filter-label>Усі товари</span>
                      <span class="catalog-filter__count" aria-hidden="true">{products.length}</span>
                    </button>

                    <button
                      class="catalog-filter"
                      type="button"
                      aria-pressed="false"
                      data-catalog-filter="featured"
                    >
                      <span class="catalog-filter__label" data-catalog-filter-label>З чого почати</span>
                      <span class="catalog-filter__count" aria-hidden="true">{featuredProductCount}</span>
                    </button>
                  </div>
                </div>

                <div class="catalog-filter-group" role="group" aria-labelledby="catalog-category-filters">
                  <p id="catalog-category-filters" class="catalog-filter-group__title">Категорії</p>
                  <div class="catalog-filter-list">
                    {
                      categoryLinks.map((category) => (
                        <button
                          class="catalog-filter"
                          type="button"
                          aria-pressed="false"
                          data-catalog-filter="category"
                          data-catalog-category={category.name}
                          data-catalog-href={href(`catalog/${category.slug}/`)}
                        >
                          <span class="catalog-filter__label" data-catalog-filter-label>
                            {category.shortLabel}
                          </span>
                          <span class="catalog-filter__count" aria-hidden="true">{category.count}</span>
                        </button>
                      ))
                    }
                  </div>
                </div>
              </nav>
            </div>

            {/* The script points this at the active category landing page, so a
                filtered product view always has a route to the full category —
                the answer to "is there more inside this category". */}
            <div class="catalog-sidebar__foot">
              <a class="catalog-sidebar__link" href={href('catalog/')} data-catalog-section-link>
                Усі категорії
              </a>
            </div>
          </aside>

          <button
            class="catalog-sidebar-backdrop"
            type="button"
            aria-label="Закрити фільтри каталогу"
            hidden
            data-catalog-sidebar-backdrop
          ></button>

          <div class="catalog-content" data-catalog-content>
            {
              products.length > 0 ? (
                <>
                  <div class="catalog-grid" data-catalog-grid>
                    {products.map((product) => (
                      <div
                        class="catalog-grid__item"
                        data-catalog-item
                        data-product-sku={product.sku}
                        data-product-family={product.familyId ?? undefined}
                        data-catalog-category={product.category ?? ''}
                        data-catalog-featured={product.featured ? 'true' : 'false'}
                      >
                        <ProductCard product={product} />
                      </div>
                    ))}
                  </div>

                  <div class="catalog-no-results" hidden data-catalog-filter-empty>
                    <div class="catalog-no-results__art" aria-hidden="true"><span class="ears"></span></div>
                    <h2 class="catalog-no-results__title">За цим фільтром товарів немає</h2>
                    <p class="catalog-no-results__text">
                      Спробуй іншу категорію або «Усі товари», щоб побачити решту виробів.
                    </p>
                  </div>
                </>
              ) : (
                <div class="catalog-no-results">
                  <div class="catalog-no-results__art" aria-hidden="true"><span class="ears"></span></div>
                  <h2 class="catalog-no-results__title">Каталог поки порожній</h2>
                  <p class="catalog-no-results__text">
                    Опублікованих товарів ще немає. Контакти магазину є нижче.
                  </p>
                </div>
              )
            }
          </div>
        </div>

        <p
          class="sr-only"
          aria-live="polite"
          aria-atomic="true"
          data-catalog-filter-status
        ></p>
      </div>
    </section>

    <SlaPreview />

    <section class="catalog-order" aria-labelledby="order-title">
      <div class="container catalog-order__inner">
        <div class="catalog-order__intro">
          <h2 id="order-title">Як замовити</h2>
          <p>
            Обери виріб і напиши напряму в Telegram або Viber. У повідомленні
            вкажи артикул (P…), кількість, колір і потрібне виконання; за потреби — матеріал.
            Перед виготовленням узгодь сумісність і склад комплекту — так буде легше підготувати збірку.
          </p>
          <ContactActions message="Вітаю! Хочу замовити виріб із каталогу TANMEK." />
          <a class="contact-marketplace" href={olxUrl} target="_blank" rel="noopener noreferrer">
            Або замовити через OLX ↗
          </a>
        </div>

        <div class="catalog-order__details">
          {FAQ_ITEMS.map((item) => (
            <details class="catalog-order__item disclosure">
              <summary data-faq-question>{item.question}</summary>
              <p data-faq-answer>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>

  <script>
    import { createCatalogEntrance } from '../scripts/catalog-motion';
    const catalogPage = document.querySelector<HTMLElement>('[data-catalog-page]');

    if (catalogPage) {
      const categoryNav = catalogPage.querySelector<HTMLElement>('[data-catalog-category-nav]');
      const filterButtons = Array.from(
        catalogPage.querySelectorAll<HTMLButtonElement>('[data-catalog-filter]'),
      );
      const catalogItems = Array.from(
        catalogPage.querySelectorAll<HTMLElement>('[data-catalog-item]'),
      );
      const visibleCounts = Array.from(
        catalogPage.querySelectorAll<HTMLElement>('[data-catalog-visible-count]'),
      );
      const activeLabels = Array.from(
        catalogPage.querySelectorAll<HTMLElement>('[data-catalog-active-label]'),
      );
      const filterStatus = catalogPage.querySelector<HTMLElement>(
        '[data-catalog-filter-status]',
      );
      const filterEmpty = catalogPage.querySelector<HTMLElement>('[data-catalog-filter-empty]');
      const catalogMain = catalogPage.querySelector<HTMLElement>('[data-catalog-main]');
      const sectionLink = catalogPage.querySelector<HTMLAnchorElement>(
        '[data-catalog-section-link]',
      );
      const sidebar = catalogPage.querySelector<HTMLElement>('[data-catalog-sidebar]');
      const sidebarOpen = catalogPage.querySelector<HTMLButtonElement>(
        '[data-catalog-sidebar-open]',
      );
      const sidebarClose = catalogPage.querySelector<HTMLButtonElement>(
        '[data-catalog-sidebar-close]',
      );
      const sidebarBackdrop = catalogPage.querySelector<HTMLButtonElement>(
        '[data-catalog-sidebar-backdrop]',
      );
      const mobileToolbar = catalogPage.querySelector<HTMLElement>(
        '[data-catalog-mobile-toolbar]',
      );
      // The panel's own scroll container: as a drawer only this middle band
      // moves, so head and foot stay pinned.
      const sidebarBody = catalogPage.querySelector<HTMLElement>(
        '[data-catalog-sidebar-body]',
      );

      if (
        categoryNav &&
        filterButtons.length > 0 &&
        catalogItems.length > 0 &&
        sidebar &&
        sidebarOpen &&
        sidebarClose &&
        sidebarBackdrop &&
        mobileToolbar
      ) {
        categoryNav.hidden = false;
        mobileToolbar.hidden = false;
        sidebarBackdrop.hidden = false;

        // The unfiltered state of the contextual link, restored whenever the
        // active filter is not a single category.
        const defaultLinkHref = sectionLink?.getAttribute('href') ?? '';
        const defaultLinkLabel = sectionLink?.textContent?.trim() ?? '';

        const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        // Must match the 900px drawer breakpoint in catalog.css: above it the
        // sidebar is a static column and "opening" it means nothing.
        const mobileQuery = window.matchMedia('(max-width: 900px)');
        const scrollBehavior = (): ScrollBehavior => (motionQuery.matches ? 'auto' : 'smooth');
        const animateItems = createCatalogEntrance(catalogItems, motionQuery);
        let drawerOpen = false;

        // Sticky-header height, so a programmatic scroll never parks the mobile
        // catalog toolbar underneath the site header.
        const headerOffset = () => {
          const raw = getComputedStyle(document.documentElement).getPropertyValue('--header-h');
          const parsed = Number.parseFloat(raw);
          return Number.isFinite(parsed) ? parsed : 0;
        };

        // Locking the page behind the drawer removes a classic scrollbar, which
        // would otherwise shift everything under the translucent scrim sideways
        // by its width. The gutter has to be measured before the class lands,
        // while the scrollbar is still there; overlay scrollbars report 0.
        const setScrollLock = (locked: boolean) => {
          const root = document.documentElement;

          if (locked) {
            const gutter = Math.max(window.innerWidth - root.clientWidth, 0);
            root.style.setProperty('--catalog-scrollbar-gutter', `${gutter}px`);
          }

          document.body.classList.toggle('catalog-drawer-open', locked);

          if (!locked) root.style.removeProperty('--catalog-scrollbar-gutter');
        };

        // A control inside a collapsed group or an unpainted panel is not a
        // real tab stop; getClientRects() is what actually tells them apart.
        const focusableInDrawer = () =>
          Array.from(
            sidebar.querySelectorAll<HTMLElement>(
              'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
            ),
          ).filter((element) => element.getClientRects().length > 0);

        const setDrawerOpen = (open: boolean, restoreFocus = true) => {
          const nextOpen = open && mobileQuery.matches;
          const wasOpen = drawerOpen;
          drawerOpen = nextOpen;

          sidebar.classList.toggle('is-open', nextOpen);
          sidebarBackdrop.classList.toggle('is-open', nextOpen);
          sidebarOpen.setAttribute('aria-expanded', String(nextOpen));
          setScrollLock(nextOpen);

          if (nextOpen) {
            sidebar.removeAttribute('aria-hidden');
            sidebar.removeAttribute('inert');
            sidebar.setAttribute('role', 'dialog');
            sidebar.setAttribute('aria-modal', 'true');

            // Do not leave the site-header menu open behind the modal drawer.
            const headerBurger = document.querySelector<HTMLButtonElement>('.site-header__burger');
            const headerDrawer = document.getElementById('site-header-menu');
            if (headerBurger?.getAttribute('aria-expanded') === 'true') {
              headerBurger.setAttribute('aria-expanded', 'false');
              headerBurger.setAttribute('aria-label', 'Відкрити меню');
              headerDrawer?.classList.remove('is-open');
            }

            // Reopening after picking a category should show that
            // category, not the top of the list.
            const pressed = filterButtons.find(
              (button) => button.getAttribute('aria-pressed') === 'true',
            );
            if (pressed && sidebarBody) {
              const panel = sidebarBody.getBoundingClientRect();
              const row = pressed.getBoundingClientRect();
              if (row.top < panel.top || row.bottom > panel.bottom) {
                sidebarBody.scrollTop +=
                  row.top - panel.top - (panel.height - row.height) / 2;
              }
            }

            requestAnimationFrame(() => sidebarClose.focus());
          } else if (mobileQuery.matches) {
            // Move focus out before hiding/inerting the drawer. Otherwise
            // browsers correctly reject aria-hidden on a focused subtree.
            if (wasOpen && restoreFocus) sidebarOpen.focus();

            sidebar.setAttribute('aria-hidden', 'true');
            sidebar.setAttribute('inert', '');
            sidebar.removeAttribute('role');
            sidebar.removeAttribute('aria-modal');
          } else {
            sidebar.removeAttribute('aria-hidden');
            sidebar.removeAttribute('inert');
            sidebar.removeAttribute('role');
            sidebar.removeAttribute('aria-modal');
          }
        };

        const syncDrawerMode = () => {
          const focusWasInSidebar = sidebar.contains(document.activeElement);
          const focusWasOnTrigger = document.activeElement === sidebarOpen;
          const wasOpen = drawerOpen;

          if (mobileQuery.matches) {
            if (focusWasInSidebar) sidebarOpen.focus();
            setDrawerOpen(false, false);
          } else {
            drawerOpen = false;
            sidebar.classList.remove('is-open');
            sidebarBackdrop.classList.remove('is-open');
            sidebarOpen.setAttribute('aria-expanded', 'false');
            setScrollLock(false);
            sidebar.removeAttribute('aria-hidden');
            sidebar.removeAttribute('inert');
            sidebar.removeAttribute('role');
            sidebar.removeAttribute('aria-modal');

            if (wasOpen || focusWasInSidebar || focusWasOnTrigger) {
              const activeFilter = filterButtons.find(
                (button) => button.getAttribute('aria-pressed') === 'true',
              );
              requestAnimationFrame(() => activeFilter?.focus());
            }
          }
        };

        // Swipe-to-close. The panel carries touch-action: pan-y, so the browser
        // keeps owning vertical scrolling and only horizontal movement reaches
        // this handler; the gesture is claimed only once it is clearly sideways.
        const SWIPE_CLAIM_PX = 12;
        const SWIPE_CLOSE_PX = 56;
        let pointerId: number | null = null;
        let startX = 0;
        let startY = 0;
        let dragX = 0;
        let dragging = false;

        // A finger that travelled far enough to move the panel must not also
        // activate the filter row it happened to start on. The guard is armed
        // for one click and disarmed on a timer as well, because a swipe that
        // ends over the scrim produces no click at all — and a listener left
        // waiting would eat the reader's next, unrelated tap.
        const swallowNextClick = (event: MouseEvent) => {
          event.preventDefault();
          event.stopPropagation();
          document.removeEventListener('click', swallowNextClick, true);
        };

        const endDrag = (close: boolean) => {
          const wasDragging = dragging;

          if (pointerId !== null && sidebar.hasPointerCapture(pointerId)) {
            sidebar.releasePointerCapture(pointerId);
          }

          sidebar.classList.remove('is-dragging');
          sidebar.style.removeProperty('transform');
          pointerId = null;
          dragging = false;

          if (wasDragging) {
            document.addEventListener('click', swallowNextClick, true);
            window.setTimeout(
              () => document.removeEventListener('click', swallowNextClick, true),
              400,
            );
          }

          if (close) setDrawerOpen(false);
        };

        sidebar.addEventListener('pointerdown', (event) => {
          if (!drawerOpen || event.pointerType === 'mouse' || pointerId !== null) return;
          pointerId = event.pointerId;
          startX = event.clientX;
          startY = event.clientY;
          dragX = 0;
        });

        sidebar.addEventListener('pointermove', (event) => {
          if (pointerId !== event.pointerId) return;

          const dx = event.clientX - startX;
          const dy = event.clientY - startY;

          if (!dragging) {
            // Anything that is not decisively horizontal stays a scroll.
            if (Math.abs(dy) > Math.abs(dx)) {
              pointerId = null;
              return;
            }
            if (dx > -SWIPE_CLAIM_PX) return;
            dragging = true;
            sidebar.classList.add('is-dragging');
            // Capture only once the gesture is claimed, so a plain tap keeps
            // its normal target — and so pointerup still arrives here if the
            // finger leaves the panel mid-swipe.
            sidebar.setPointerCapture(event.pointerId);
          }

          dragX = Math.min(0, dx);
          sidebar.style.transform = `translateX(${dragX}px)`;
        });

        sidebar.addEventListener('pointerup', (event) => {
          if (pointerId !== event.pointerId) return;
          endDrag(dragging && dragX < -SWIPE_CLOSE_PX);
        });

        sidebar.addEventListener('pointercancel', (event) => {
          if (pointerId !== event.pointerId) return;
          endDrag(false);
        });

        // Filtering shortens the grid, so a viewport parked deep in the old
        // list can end up below the new one. Pull the page back to the start of
        // the catalog when it is already past it.
        const keepCatalogInView = () => {
          if (!catalogMain) return;

          const start =
            catalogMain.getBoundingClientRect().top + window.scrollY - headerOffset();

          if (window.scrollY > start) {
            window.scrollTo({ top: start, behavior: scrollBehavior() });
          }
        };

        const applyFilter = (activeButton: HTMLButtonElement) => {
          const filter = activeButton.dataset.catalogFilter;
          const category = activeButton.dataset.catalogCategory;
          let shownItems = 0;

          catalogItems.forEach((item) => {
            const isVisible =
              filter === 'all' ||
              (filter === 'featured' && item.dataset.catalogFeatured === 'true') ||
              (filter === 'category' && item.dataset.catalogCategory === category);

            item.hidden = !isVisible;
            if (isVisible) shownItems += 1;
          });

          filterButtons.forEach((button) => {
            button.setAttribute('aria-pressed', String(button === activeButton));
          });

          visibleCounts.forEach((count) => {
            count.textContent = String(shownItems);
          });
          if (filterEmpty) filterEmpty.hidden = shownItems !== 0;

          animateItems();

          const activeLabel =
            activeButton.querySelector('[data-catalog-filter-label]')?.textContent?.trim() ?? '';

          activeLabels.forEach((label) => {
            label.textContent = activeLabel;
          });

          // A filtered view is not a page; the link below the filters is what
          // carries the reader on to the category's own landing page.
          if (sectionLink) {
            const categoryHref = activeButton.dataset.catalogHref;

            if (filter === 'category' && categoryHref) {
              sectionLink.setAttribute('href', categoryHref);
              sectionLink.textContent = `Як обрати: ${activeLabel}`;
            } else {
              sectionLink.setAttribute('href', defaultLinkHref);
              sectionLink.textContent = defaultLinkLabel;
            }
          }

          if (filterStatus) {
            filterStatus.textContent = `Фільтр «${activeLabel}»: показано ${shownItems} із ${catalogItems.length} товарів.`;
          }

          // Close first: the scroll lock has to be off before the page can be
          // scrolled back to the top of the grid.
          if (mobileQuery.matches) setDrawerOpen(false);
          keepCatalogInView();
        };

        filterButtons.forEach((button) => {
          button.addEventListener('click', () => applyFilter(button));
        });

        sidebarOpen.addEventListener('click', () => setDrawerOpen(true));
        sidebarClose.addEventListener('click', () => setDrawerOpen(false));
        sidebarBackdrop.addEventListener('click', () => setDrawerOpen(false));

        document.addEventListener('keydown', (event) => {
          if (!drawerOpen || !mobileQuery.matches) return;

          if (event.key === 'Escape') {
            event.preventDefault();
            setDrawerOpen(false);
            return;
          }

          if (event.key !== 'Tab') return;

          const focusable = focusableInDrawer();

          const first = focusable[0];
          const last = focusable.at(-1);
          if (!first || !last) return;

          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });

        mobileQuery.addEventListener('change', syncDrawerMode);
        syncDrawerMode();
      }
    }
  </script>
</Layout>
