---
import Layout from '../../../components/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { CATEGORIES } from '../../../data/categories.mjs';
import { RUSSIAN_CATEGORIES } from '../../../data/categories.ru.mjs';
import { RUSSIAN_PRODUCTS } from '../../../data/products.ru.mjs';
import { SITE_NAME } from '../../../data/site.config.mjs';
import { getProductsByCategory } from '../../../utils/products';
import { absoluteUrl, href } from '../../../utils/urls';
import { graph, websiteNode, organizationNode, webPageNode, breadcrumbNode, itemListNode, faqNode } from '../../../utils/schema.mjs';
import { toJsonLd } from '../../../utils/text';
import '../../../styles/pages/content.css';
import '../../../styles/pages/catalog.css';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({params: {category: category.slug}, props: {category}}));
}
interface Props {category: (typeof CATEGORIES)[number];}
const {category} = Astro.props;
const copy = RUSSIAN_CATEGORIES[category.slug];
const products = getProductsByCategory(category.name);
const path = `/ru/catalog/${category.slug}/`;
const url = absoluteUrl(path);
const breadcrumbs = [{name: 'Главная', url: absoluteUrl('ru/')}, {name: 'Каталог', url: absoluteUrl('ru/catalog/')}, {name: copy.label, url}];
const structuredData = graph([
  websiteNode(), organizationNode(),
  webPageNode({url, name: copy.title, description: copy.description, type: 'CollectionPage', inLanguage: 'ru-UA', breadcrumbId: `${url}#breadcrumbs`}),
  breadcrumbNode(url, breadcrumbs),
  itemListNode(url, products.map((p) => ({name: RUSSIAN_PRODUCTS[p.sku].title, url: absoluteUrl(`ru/products/${p.slug}/`)})), copy.label),
  faqNode(url, copy.faq),
]);
---
<Layout title={`${copy.title} | ${SITE_NAME}`} description={copy.description} canonicalPath={path} lang="ru" ogLocale="ru_UA">
  <script slot="head" type="application/ld+json" set:html={toJsonLd(structuredData)}></script>
  <div class="content-page"><div class="container">
    <Breadcrumbs items={[{label: 'Главная', href: href('ru/')}, {label: 'Каталог', href: href('ru/catalog/')}, {label: copy.label}]} />
    <header class="content-head"><p class="kicker">Категория каталога</p><h1 class="content-head__title content-head__title--wide">{copy.title}</h1><p class="content-lead">{copy.lead}</p>
      <dl class="content-facts"><div><dt>Товаров в категории</dt><dd>{products.length}</dd></div>{products.length > 0 && <div><dt>Цены от</dt><dd>{new Intl.NumberFormat('ru-UA').format(Math.min(...products.map((p) => p.price)))} ₴</dd></div>}<div><dt>Изготовление</dt><dd>На заказ, Киев</dd></div></dl>
    </header>
    <section class="content-section" aria-labelledby="category-products"><h2 id="category-products">{copy.label}: товары и цены</h2><div class="content-products">{products.map((product) => <ProductCard product={product} lang="ru" />)}</div></section>
    <section class="content-section" aria-labelledby="category-choice"><h2 id="category-choice">Как выбрать</h2><div class="content-prose">{copy.body.map((text) => <p>{text}</p>)}</div></section>
    <section class="content-section" aria-labelledby="category-faq"><h2 id="category-faq">Вопросы перед покупкой</h2><div class="content-faq">{copy.faq.map((item) => <article class="content-faq__item"><h3 data-faq-question>{item.question}</h3><p data-faq-answer>{item.answer}</p></article>)}</div></section>
    <section class="content-section" aria-labelledby="category-related"><h2 id="category-related">Дополните сборку</h2><ul class="content-linkrow" role="list">{category.relatedCategories.map((slug) => <li><a href={href(`ru/catalog/${slug}/`)}>{RUSSIAN_CATEGORIES[slug].label}</a></li>)}</ul></section>
  </div></div>
</Layout>
